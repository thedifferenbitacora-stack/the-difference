<?php
/**
 * PATCH SETTINGS v3 · agrega claves X e Y de subtítulo y verifica.
 */
$baseDir = dirname(__DIR__);
$configFile = $baseDir . '/config/settings.json';

$missing = [
    'ars_tekne_subtitle_position_x' => 50, 'ars_tekne_subtitle_position_y' => 45,
    'le_tematik_subtitle_position_x' => 50, 'le_tematik_subtitle_position_y' => 45,
    'pensamiento_autista_subtitle_position_x' => 50, 'pensamiento_autista_subtitle_position_y' => 45,
    'project_nada_brahma_subtitle_position_x' => 50, 'project_nada_brahma_subtitle_position_y' => 45,
    'quantumlab_subtitle_position_x' => 50, 'quantumlab_subtitle_position_y' => 45,
    'quiron_theatre_subtitle_position_x' => 50, 'quiron_theatre_subtitle_position_y' => 45,
    'saiayin_do_subtitle_position_x' => 50, 'saiayin_do_subtitle_position_y' => 45,
    'texvn_subtitle_position_x' => 50, 'texvn_subtitle_position_y' => 45,
    'log_title_animation' => 'none'
];

$config = file_exists($configFile) ? json_decode(file_get_contents($configFile), true) : [];
if (!is_array($config)) $config = [];

$agregadas = [];
foreach ($missing as $k => $v) {
    if (!isset($config[$k])) { $config[$k] = $v; $agregadas[] = $k; }
}

$escrito = 'no hacía falta (ya estaban)';
if (!empty($agregadas)) {
    $ok = file_put_contents($configFile, json_encode($config, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE));
    $escrito = $ok !== false ? 'SÍ (' . count($agregadas) . ' claves)' : 'NO — error de permisos';
}

$check = json_decode(file_get_contents($configFile), true);
if (!is_array($check)) $check = [];
$faltan = 0;
foreach ($missing as $k => $v) { if (!isset($check[$k])) $faltan++; }
?>
<!DOCTYPE html>
<html lang="es"><head><meta charset="UTF-8"><title>Patch v3</title></head>
<body style="font-family:monospace;background:#0f0f0f;color:#10b981;padding:2rem;">
<h2>🔧 Patch Settings v3</h2>
<p>Escritura: <strong><?= htmlspecialchars($escrito) ?></strong></p>
<p>Claves verificadas: <strong><?= count($missing) - $faltan ?> / <?= count($missing) ?> presentes</strong></p>
<?php if ($faltan === 0): ?>
    <p>✅ Todo presente. Manda este archivo a backup y pasa el 🩺 Chequeo: los avisos de nodos quedan en cero.</p>
<?php else: ?>
    <p>❌ Aún faltan <?= $faltan ?> claves. Revisa permisos de settings.json.</p>
<?php endif; ?>
</body></html>