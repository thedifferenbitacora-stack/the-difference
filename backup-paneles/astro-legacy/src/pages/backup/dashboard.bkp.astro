---
import Base from '../layouts/Base.astro';
---

<Base title="Quantum Core // Dashboard">
    
    <div style="padding: 20px;">
        <a href="/" 
           style="border: 1px solid #fff; color: #fff; padding: 10px 20px; text-decoration: none; font-family: monospace; transition: 0.3s; display: inline-block;"
           onmouseover="this.style.borderColor='#ff3e96'; this.style.color='#ff3e96';" 
           onmouseout="this.style.borderColor='#fff'; this.style.color='#fff';">
           VOLVER A INICIO
        </a>
    </div>

    <h1>QUANTUM CORE // DASHBOARD // MATRIX CONTROL</h1>
    
    <div class="grid">
        <!-- [01] TÉCNICO -->
        <div class="box">
            <div class="header">[01] TÉCNICO // ENTRADA</div>
            <button id="btn-mcp">CONECTAR MCP</button>
            <div id="log-tech" style="margin-top: 10px;"><p>> Sistema en espera...</p></div>
        </div>

        <!-- [02] ÍNDICE -->
        <div class="box">
            <div class="header">[02] ÍNDICE // MEMORIA</div>
            <div id="log-mem"><p>> Esperando sincronización...</p></div>
        </div>

        <!-- [03] MOTOR DIALÉCTICO -->
        <div class="box">
            <div class="header">[03] MOTOR // DIALÉCTICO</div>
            <p>> <strong>LAB:</strong> ARS-TEKNE</p>
            <p>> <strong>FASE:</strong> <span id="fase">TESIS (INACTIVO)</span></p>
            <div style="background: #222; height: 8px; width: 100%; margin: 10px 0;">
                <div id="progress" style="background: #32cd32; width: 33%; height: 100%;"></div>
            </div>
            <button id="btn-next">AVANZAR FASE</button>
        </div>

        <!-- [04] CONTEXTO -->
        <div class="box">
            <div class="header">[04] CONTEXTO // CONCEPTUAL</div>
            <p><strong>FILOSOFÍA:</strong> THE DIFFERENCE</p>
            <p><strong>ESTADO:</strong> Loop Dialéctico Operativo.</p>
        </div>
    </div>

    <style>
        h1 { padding: 20px; font-size: 1.5rem; text-transform: uppercase; border-bottom: 1px dashed #333; color: white; }
        .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; padding: 20px; }
        .box { border: 1px solid #333; padding: 15px; background: #050505; color: #888; }
        .header { color: white; font-weight: bold; margin-bottom: 10px; border-bottom: 1px solid #333; padding-bottom: 5px; }
        button { background: transparent; color: #32cd32; border: 1px solid #32cd32; padding: 5px 10px; cursor: pointer; font-family: monospace; transition: 0.3s; }
        button:hover { background: #32cd32; color: black; }
    </style>

    <script>
        // Lógica restaurada para el Motor Dialéctico
        const btnNext = document.getElementById('btn-next');
        const fase = document.getElementById('fase');
        const progress = document.getElementById('progress');

        if (btnNext) {
            btnNext.addEventListener('click', () => {
                if (fase.innerText === "TESIS (INACTIVO)") {
                    fase.innerText = "TESIS (ACTIVO)";
                    progress.style.width = "66%";
                } else if (fase.innerText === "TESIS (ACTIVO)") {
                    fase.innerText = "SÍNTESIS (COMPLETO)";
                    progress.style.width = "100%";
                    progress.style.background = "#ff3e96";
                }
            });
        }
    </script>
</Base>