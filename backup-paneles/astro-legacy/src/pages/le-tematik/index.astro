---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="LE TEMATIK">
  <section class="panel-section">
    <h1 class="panel-title" style="color: #ffcc00; border-color: #ffcc00;">LE TEMATIK</h1>
    
    <div class="three-columns">
      <div class="column">
        <a href="/le-tematik/label" class="control-button magenta">LABEL</a>
        <div class="sub-buttons">
          <a href="/le-tematik/label/deonstructor" class="control-button">DEONSTRUCTOR DE CANCIONES</a>
          <a href="/le-tematik/label/tematik-letters" class="control-button">TEMATIK LETTERS</a>
        </div>
      </div>

      <div class="column">
        <a href="/le-tematik/agency" class="control-button magenta">AGENCY</a>
        <div class="sub-buttons">
          <a href="/le-tematik/agency/vigilia" class="control-button">VIGILIA CONSCIENTE</a>
          <a href="/le-tematik/agency/tematik-records" class="control-button">TEMATIK RECORDS</a>
          <a href="/le-tematik/agency/le-tematik" class="control-button">LE TEMATIK</a>
          <a href="/le-tematik/agency/latino-rebelde" class="control-button">LATINO REBELDE</a>
        </div>
      </div>

      <div class="column">
        <a href="/le-tematik/producer" class="control-button magenta">PRODUCER</a>
        <div class="sub-buttons">
          <a href="/le-tematik/producer/quiron-theatre" class="control-button">QUIRON THEATRE</a>
          <a href="/le-tematik/producer/saiayin-do" class="control-button">SAIAYIN DO</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .three-columns {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    max-width: 1400px;
    margin: 0 auto;
  }

  .column {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .sub-buttons {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1rem;
  }
</style>