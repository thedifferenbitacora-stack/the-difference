---
import Layout from '../layouts/Layout.astro';
import MenuReturn from '../components/MenuReturn.astro';
import fs from 'fs/promises';
import path from 'path';

const nodoId = Astro.url.searchParams.get('nodo') || 'quantumlab';

let tareas: any[] = [];
try {
  const tareasPath = path.join(process.cwd(), '01_BITACORA_GLOBAL', 'TAREAS_PROYECTOS.json');
  const data = await fs.readFile(tareasPath, 'utf-8');
  const todas = JSON.parse(data);
  tareas = todas.filter((t: any) => String(t.nodo).toLowerCase() === String(nodoId).toLowerCase());
} catch (e) {
  tareas = [];
}

const nodosInfo: Record<string, { nombre: string; descripcion: string; tipo: string }> = {
  'log': { nombre: 'LOG', descripcion: 'Registro y bitácora del sistema', tipo: 'Estudio de Memoria' },
  'le-tematik': { nombre: 'LE TEMATIK', descripcion: 'Label · Agency · Producer · Arquitectura Sonora', tipo: 'Estudio Musical' },
  'nada-brahma': { nombre: 'PROJECT NADA BRAHMA', descripcion: 'Centro Técnico I+D · Posición de Autonomía', tipo: 'Laboratorio de Investigación' },
  'texvn': { nombre: 'TEXVN', descripcion: 'Ars y Tekné · Reunión de Oficios', tipo: 'Taller Técnico' },
  'quantumlab': { nombre: 'QUANTUMLAB', descripcion: 'Laboratorio de Experimentación Sonora y Cuántica', tipo: 'Laboratorio Experimental' },
  'pensamiento-autista': { nombre: 'PENSAMIENTO AUTISTA', descripcion: 'Modelos Cognitivos y Neurodivergencia', tipo: 'Espacio de Investigación Cognitiva' },
  'saiayin-do': { nombre: 'SAIAYIN DO', descripcion: 'Bitácora de Resiliencia · Distribución Energética', tipo: 'Espacio de Rehabilitación' },
  'ars-tekne': { nombre: 'ARS TEKNE', descripcion: 'Fundación Artístico-Técnica', tipo: 'Departamento Autónomo' },
  'quiron-theatre': { nombre: 'QUIRÓN THEATRE', descripcion: 'Dispositivo Hermenéutico · La Escena del Ser', tipo: 'Espacio Escénico' }
};

const info = nodosInfo[nodoId] || { nombre: nodoId.toUpperCase(), descripcion: 'Nodo del sistema', tipo: 'Estudio' };

const conteoPorEstado = {
  PENDIENTE: tareas.filter(t => t.estado === 'PENDIENTE').length,
  EN_PROCESO: tareas.filter(t => t.estado === 'EN_PROCESO').length,
  FINALIZADO: tareas.filter(t => t.estado === 'FINALIZADO').length
};

const proyectos = [...new Set(tareas.map(t => t.proyecto).filter(Boolean))];
---

<Layout title={`GEIST // Tareas: ${info.nombre}`}>
  <MenuReturn href="/dashboard-tareas" label="THE DIFFERENCE" />

  <main class="nodo-main">
    <header class="nodo-header">
      <div class="nodo-badge">{info.tipo.toUpperCase()}</div>
      <h1>{info.nombre}</h1>
      <p class="nodo-desc">{info.descripcion}</p>
      <p class="nodo-subtitle">TAREAS POR PROYECTO · BITÁCORA CONSCIENTE</p>
    </header>

    <!-- STATS DEL NODO -->
    <section class="nodo-stats">
      <div class="stat-mini stat-p"><div class="stat-n">{conteoPorEstado.PENDIENTE}</div><div class="stat-l">PENDIENTES</div></div>
      <div class="stat-mini stat-e"><div class="stat-n">{conteoPorEstado.EN_PROCESO}</div><div class="stat-l">EN PROCESO</div></div>
      <div class="stat-mini stat-f"><div class="stat-n">{conteoPorEstado.FINALIZADO}</div><div class="stat-l">FINALIZADOS</div></div>
      <div class="stat-mini stat-t"><div class="stat-n">{tareas.length}</div><div class="stat-l">TOTAL</div></div>
    </section>

    <!-- PROYECTOS DEL NODO -->
    {proyectos.length > 0 && (
      <section class="proyectos-section">
        <h2><span class="icon">📁</span> PROYECTOS ACTIVOS EN ESTE TALLER</h2>
        <div class="proyectos-list">
          {proyectos.map(proy => {
            const tareasProy = tareas.filter(t => t.proyecto === proy);
            const pendientes = tareasProy.filter(t => t.estado !== 'FINALIZADO').length;
            const completadas = tareasProy.filter(t => t.estado === 'FINALIZADO').length;
            const progreso = tareasProy.length > 0 ? Math.round((completadas / tareasProy.length) * 100) : 0;
            return (
              <div class="proyecto-card">
                <div class="proyecto-header">
                  <h3 class="proyecto-nombre">{proy}</h3>
                  <span class="proyecto-progreso">{progreso}%</span>
                </div>
                <div class="proyecto-bar">
                  <div class="proyecto-fill" style={`width: ${progreso}%`}></div>
                </div>
                <div class="proyecto-info">
                  <span>{tareasProy.length} tareas</span>
                  <span>{pendientes} pendientes</span>
                  <span>{completadas} finalizadas</span>
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )}

    <!-- TAREAS DEL NODO -->
    <section class="tareas-nodo-section">
      <h2><span class="icon"></span> TAREAS DE ESTE TALLER</h2>
      
      {tareas.length === 0 ? (
        <div class="empty-nodo">
          <p>> Este taller aún no tiene tareas registradas.</p>
          <a href="/dashboard-tareas" class="btn-ir">IR A REGISTRAR TAREAS</a>
        </div>
      ) : (
        <div class="tareas-nodo-list">
          {tareas.map((tarea: any) => (
            <div class={`tarea-nodo-item tarea-${String(tarea.estado).toLowerCase().replace(/ /g, '-')}`}>
              <div class="tn-top">
                <span class="tn-id">{tarea.id}</span>
                <span class={`tn-estado estado-${String(tarea.estado).toLowerCase().replace(/ /g, '-')}`}>{tarea.estado}</span>
                <span class={`tn-prioridad prioridad-${String(tarea.prioridad).toLowerCase()}`}>{tarea.prioridad}</span>
              </div>
              <div class="tn-proyecto">{tarea.proyecto}</div>
              <h3 class="tn-titulo">{tarea.titulo}</h3>
              {tarea.descripcion && <p class="tn-desc">{tarea.descripcion}</p>}
              {tarea.que_falta && (
                <div class="tn-falta">
                  <span class="tn-falta-label">⚠ QUÉ FALTA:</span>
                  <span>{tarea.que_falta}</span>
                </div>
              )}
              <div class="tn-meta">
                <span>📅 {tarea.fecha_identificacion || '-'}</span>
                {tarea.tiempo_total && <span class="tn-tiempo">⏱ {tarea.tiempo_total}</span>}
                {(tarea.energia_costo || tarea.energia_valor) && <span>⚡ {tarea.energia_costo || '-'}/{tarea.energia_valor || '-'}</span>}
              </div>
              {tarea.observacion && <p class="tn-obs">"{tarea.observacion}"</p>}
            </div>
          ))}
        </div>
      )}
    </section>

    <!-- NAVEGACIÓN ENTRE NODOS -->
    <section class="nav-nodos">
      <h2><span class="icon">🏛️</span> OTROS TALLERES</h2>
      <div class="nav-nodos-grid">
        {Object.entries(nodosInfo).map(([id, n]) => {
          if (id === nodoId) return null;
          return (
            <a href={`/tareas-nodo?nodo=${id}`} class="nav-nodo-link">
              <span class="nav-nodo-nombre">{n.nombre}</span>
            </a>
          );
        })}
      </div>
    </section>
  </main>
</Layout>

<style>
  :root { --color-black: #000000; --color-white: #ffffff; --color-pink: #ff3e96; --color-green: #00ff00; --color-red: #ff3333; --color-yellow: #ffaa00; --color-blue: #00aaff; --color-dim: #888888; --border-alpha: rgba(255, 255, 255, 0.15); --font-mono: 'Courier New', Courier, monospace; --font-sans: 'Impact', 'Arial Black', sans-serif; }
  
  .nodo-main { max-width: 1200px; margin: 0 auto; padding: 40px 20px; font-family: var(--font-mono); color: var(--color-white); }
  .nodo-header { text-align: center; margin-bottom: 40px; border-bottom: 1px solid var(--border-alpha); padding-bottom: 25px; }
  .nodo-badge { display: inline-block; background: var(--color-pink); color: var(--color-black); padding: 5px 15px; font-size: 0.75rem; letter-spacing: 2px; margin-bottom: 15px; font-weight: bold; }
  .nodo-header h1 { font-family: var(--font-sans); font-size: 2.5rem; color: var(--color-white); letter-spacing: 3px; margin-bottom: 10px; }
  .nodo-desc { color: var(--color-white); font-size: 1rem; margin-bottom: 5px; }
  .nodo-subtitle { color: var(--color-dim); font-size: 0.85rem; letter-spacing: 2px; }
  
  section { margin-bottom: 40px; }
  section h2 { font-size: 1.2rem; color: var(--color-pink); margin-bottom: 20px; display: flex; align-items: center; gap: 10px; letter-spacing: 1px; }
  .icon { font-size: 1.4rem; }
  
  /* STATS */
  .nodo-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; margin-bottom: 30px; }
  .stat-mini { border: 1px solid var(--border-alpha); padding: 20px 10px; text-align: center; background: rgba(255, 255, 255, 0.02); }
  .stat-n { font-family: var(--font-sans); font-size: 2rem; margin-bottom: 5px; }
  .stat-l { font-size: 0.7rem; letter-spacing: 2px; color: var(--color-dim); }
  .stat-p .stat-n { color: var(--color-yellow); }
  .stat-e .stat-n { color: var(--color-blue); }
  .stat-f .stat-n { color: var(--color-green); }
  .stat-t .stat-n { color: var(--color-pink); }
  
  /* PROYECTOS */
  .proyectos-list { display: flex; flex-direction: column; gap: 15px; }
  .proyecto-card { border: 1px solid var(--border-alpha); padding: 20px; background: rgba(255, 255, 255, 0.02); }
  .proyecto-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
  .proyecto-nombre { font-size: 1.1rem; color: var(--color-white); margin: 0; }
  .proyecto-progreso { color: var(--color-green); font-weight: bold; font-size: 1.2rem; }
  .proyecto-bar { height: 6px; background: rgba(255, 255, 255, 0.1); margin-bottom: 10px; overflow: hidden; }
  .proyecto-fill { height: 100%; background: linear-gradient(90deg, var(--color-pink), var(--color-green)); transition: width 0.5s; }
  .proyecto-info { display: flex; gap: 20px; font-size: 0.8rem; color: var(--color-dim); }
  
  /* TAREAS NODO */
  .tareas-nodo-list { display: flex; flex-direction: column; gap: 15px; }
  .tarea-nodo-item { border: 1px solid var(--border-alpha); padding: 20px; background: rgba(255, 255, 255, 0.02); }
  .tarea-nodo-item.tarea-pendiente { border-left: 4px solid var(--color-yellow); }
  .tarea-nodo-item.tarea-en_proceso { border-left: 4px solid var(--color-blue); }
  .tarea-nodo-item.tarea-finalizado { border-left: 4px solid var(--color-green); opacity: 0.85; }
  
  .tn-top { display: flex; gap: 10px; align-items: center; margin-bottom: 10px; flex-wrap: wrap; }
  .tn-id { font-size: 0.75rem; color: var(--color-dim); }
  .tn-estado { font-size: 0.7rem; padding: 2px 8px; border: 1px solid currentColor; }
  .estado-pendiente { color: var(--color-yellow); }
  .estado-en_proceso { color: var(--color-blue); }
  .estado-finalizado { color: var(--color-green); }
  .tn-prioridad { font-size: 0.7rem; font-weight: bold; margin-left: auto; }
  .prioridad-baja { color: var(--color-dim); }
  .prioridad-media { color: var(--color-white); }
  .prioridad-alta { color: var(--color-yellow); }
  .prioridad-critica { color: var(--color-red); }
  
  .tn-proyecto { font-size: 0.75rem; color: var(--color-pink); letter-spacing: 1px; margin-bottom: 5px; }
  .tn-titulo { font-size: 1.1rem; margin-bottom: 8px; color: var(--color-white); }
  .tn-desc { font-size: 0.85rem; color: var(--color-dim); line-height: 1.5; margin-bottom: 10px; }
  .tn-falta { background: rgba(255, 170, 0, 0.1); border-left: 3px solid var(--color-yellow); padding: 10px; font-size: 0.85rem; margin-bottom: 10px; }
  .tn-falta-label { color: var(--color-yellow); font-weight: bold; margin-right: 8px; }
  
  .tn-meta { display: flex; gap: 20px; flex-wrap: wrap; padding: 10px 0; border-top: 1px solid var(--border-alpha); border-bottom: 1px solid var(--border-alpha); font-size: 0.8rem; color: var(--color-dim); }
  .tn-tiempo { color: var(--color-green); font-weight: bold; }
  .tn-obs { font-style: italic; color: var(--color-dim); font-size: 0.85rem; margin-top: 10px; padding-left: 10px; border-left: 2px solid var(--color-pink); }
  
  .empty-nodo { text-align: center; padding: 40px; border: 1px dashed var(--border-alpha); }
  .empty-nodo p { color: var(--color-dim); margin-bottom: 20px; }
  .btn-ir { display: inline-block; padding: 10px 25px; border: 2px solid var(--color-pink); color: var(--color-pink); text-decoration: none; font-family: var(--font-mono); font-weight: bold; letter-spacing: 1px; transition: all 0.2s; }
  .btn-ir:hover { background: var(--color-pink); color: var(--color-black); }
  
  /* NAV NODOS */
  .nav-nodos-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px; }
  .nav-nodo-link { border: 1px solid var(--border-alpha); padding: 15px; text-decoration: none; color: var(--color-white); text-align: center; transition: all 0.2s; }
  .nav-nodo-link:hover { border-color: var(--color-pink); color: var(--color-pink); transform: translateY(-2px); }
  .nav-nodo-nombre { font-family: var(--font-sans); font-size: 0.9rem; letter-spacing: 1px; }
  
  @media (max-width: 768px) {
    .nodo-stats { grid-template-columns: repeat(2, 1fr); }
    .nodo-header h1 { font-size: 1.8rem; }
  }
</style>