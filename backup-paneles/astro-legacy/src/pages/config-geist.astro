---
import Layout from '../layouts/Layout.astro';
import MenuReturn from '../components/MenuReturn.astro';
import fs from 'fs/promises';
import path from 'path';

// Configuración inicial por defecto
const defaultConfig = {
  preguntas: {
    inicio: [
      "¿Qué fenómeno estás observando en este momento?",
      "¿Qué nodo del sistema está involucrado?",
      "¿Es esto un problema, una oportunidad o una exploración?"
    ],
    espacio: [
      "¿Dónde se ubica esto físicamente en el taller?",
      "¿Qué archivos o carpetas están involucrados?",
      "¿Qué hardware está participando?"
    ],
    tiempo: [
      "¿Cuándo comenzó este fenómeno?",
      "¿Cuál es el ritmo natural de este proceso?",
      "¿Respeta los ciclos estacionales del taller?"
    ],
    energia: [
      "¿Cuánta Energía-Salud te está costando (1-10)?",
      "¿Este movimiento genera flujo o drena al operador?",
      "¿Qué retorno energético esperas?"
    ],
    habito: [
      "¿Qué patrón se está repitiendo?",
      "¿Qué disciplina sostiene este proceso?",
      "¿Es coherente con el camino del taller?"
    ],
    lenguaje: [
      "¿Cómo nombrarías esto con precisión ontológica?",
      "¿Qué palabras usa el sistema para describirse?",
      "¿Encarna la filosofía de The Difference?"
    ],
    correccion: [
      "¿Se alinea con la visión artística (Ars) del nodo?",
      "¿Aporta al propósito ontológico (Valor) de la Fundación?",
      "¿Qué corrección necesita su posición en el espacio-tiempo?"
    ]
  },
  nodos: [
    { id: 'log', nombre: 'LOG', activo: true },
    { id: 'le-tematik', nombre: 'LE TEMATIK', activo: true },
    { id: 'nada-brahma', nombre: 'PROJECT NADA BRAHMA', activo: true },
    { id: 'texvn', nombre: 'TEXVN', activo: true },
    { id: 'quantumlab', nombre: 'QUANTUMLAB', activo: true },
    { id: 'pensamiento-autista', nombre: 'PENSAMIENTO AUTISTA', activo: true },
    { id: 'saiayin-do', nombre: 'SAIAYIN DO', activo: true },
    { id: 'ars-tekne', nombre: 'ARS TEKNE', activo: true },
    { id: 'quiron-theatre', nombre: 'QUIRÓN THEATRE', activo: true }
  ],
  dimensiones: {
    energia: { min: 1, max: 10, unidad: 'nivel' },
    tiempo: { formato: 'ISO', zona: 'America/Santiago' }
  }
};

// Intentar cargar configuración guardada
let config = defaultConfig;
try {
  const configPath = path.join(process.cwd(), '00_BIOS_CORE', 'geist-config.json');
  const data = await fs.readFile(configPath, 'utf-8');
  config = JSON.parse(data);
} catch (e) {
  // Usar configuración por defecto si no existe el archivo
}

const secciones = [
  { id: 'inicio', nombre: 'Fenomenología Inicial', icono: '🔍' },
  { id: 'espacio', nombre: 'Espacio', icono: '📍' },
  { id: 'tiempo', nombre: 'Tiempo', icono: '' },
  { id: 'energia', nombre: 'Energía', icono: '⚡' },
  { id: 'habito', nombre: 'Hábito', icono: '🔄' },
  { id: 'lenguaje', nombre: 'Lenguaje', icono: '💬' },
  { id: 'correccion', nombre: 'Corrección Ontológica', icono: '️' }
];
---

<Layout title="GEIST // Configuración">
  <MenuReturn href="/dashboard" label="← VOLVER AL DASHBOARD" />

  <main class="config-container">
    <header class="config-header">
      <h1>GEIST // CONFIGURACIÓN DEL SISTEMA</h1>
      <p class="subtitle">Edita las preguntas ontológicas y parámetros del proceso</p>
    </header>

    <div class="config-grid">
      <!-- Panel de Nodos -->
      <section class="config-section">
        <h2><span class="section-icon">🏛️</span> NODOS ACTIVOS</h2>
        <div class="nodos-list">
          {config.nodos.map((nodo: any) => (
            <div class="nodo-item">
              <input 
                type="checkbox" 
                id={`nodo-${nodo.id}`} 
                checked={nodo.activo}
                data-nodo={nodo.id}
                class="nodo-toggle"
              />
              <label for={`nodo-${nodo.id}`} class="nodo-label">{nodo.nombre}</label>
            </div>
          ))}
        </div>
      </section>

      <!-- Panel de Preguntas por Sección -->
      {secciones.map((seccion: any) => (
        <section class="config-section">
          <h2><span class="section-icon">{seccion.icono}</span> {seccion.nombre.toUpperCase()}</h2>
          <div class="preguntas-container">
            {config.preguntas[seccion.id]?.map((pregunta: string, index: number) => (
              <div class="pregunta-item">
                <label class="pregunta-label">Pregunta {index + 1}</label>
                <textarea 
                  class="pregunta-input"
                  data-seccion={seccion.id}
                  data-index={index}
                  rows="2"
                >{pregunta}</textarea>
              </div>
            ))}
            <button 
              class="btn-add-pregunta"
              data-seccion={seccion.id}
            >
              + Agregar Pregunta
            </button>
          </div>
        </section>
      ))}

      <!-- Panel de Dimensiones -->
      <section class="config-section">
        <h2><span class="section-icon">📊</span> PARÁMETROS DE DIMENSIONES</h2>
        <div class="dimensiones-config">
          <div class="dimension-item">
            <label>Energía - Mínimo</label>
            <input 
              type="number" 
              id="energia-min" 
              value={config.dimensiones.energia.min}
              min="0"
              max="10"
            />
          </div>
          <div class="dimension-item">
            <label>Energía - Máximo</label>
            <input 
              type="number" 
              id="energia-max" 
              value={config.dimensiones.energia.max}
              min="1"
              max="10"
            />
          </div>
        </div>
      </section>
    </div>

    <!-- Botones de Acción -->
    <div class="action-buttons">
      <button id="btn-guardar" class="btn-primary">
        💾 GUARDAR CONFIGURACIÓN
      </button>
      <button id="btn-reset" class="btn-secondary">
        🔄 RESTAURAR DEFAULT
      </button>
      <button id="btn-export" class="btn-secondary">
        📤 EXPORTAR JSON
      </button>
    </div>

    <!-- Consola de Estado -->
    <div class="console-status" id="consoleStatus">
      <p class="system-msg">> Sistema de configuración listo...</p>
    </div>
  </main>
</Layout>

<style>
  :root { --color-black: #000000; --color-white: #ffffff; --color-pink: #ff3e96; --color-green-terminal: #00ff00; --color-dim: #555555; --border-alpha: rgba(255, 255, 255, 0.15); --font-mono: 'Courier New', Courier, monospace; }
  
  .config-container { 
    max-width: 1200px; 
    margin: 0 auto; 
    padding: 40px 20px; 
    background: var(--color-black); 
    color: var(--color-white); 
    font-family: var(--font-mono);
    min-height: 100vh;
  }
  
  .config-header { 
    text-align: center; 
    margin-bottom: 40px; 
    border-bottom: 1px solid var(--border-alpha); 
    padding-bottom: 20px;
  }
  
  .config-header h1 { 
    font-size: 2rem; 
    margin-bottom: 10px; 
    color: var(--color-pink);
    letter-spacing: 2px;
  }
  
  .subtitle { 
    color: var(--color-dim); 
    font-size: 0.9rem;
  }
  
  .config-grid { 
    display: grid; 
    gap: 30px;
    margin-bottom: 30px;
  }
  
  .config-section { 
    border: 1px solid var(--border-alpha); 
    padding: 25px; 
    background: rgba(255, 255, 255, 0.02);
  }
  
  .config-section h2 { 
    font-size: 1.1rem; 
    margin-bottom: 20px; 
    color: var(--color-pink);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  
  .section-icon { font-size: 1.3rem; }
  
  .nodos-list { 
    display: grid; 
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); 
    gap: 15px;
  }
  
  .nodo-item { 
    display: flex; 
    align-items: center; 
    gap: 10px;
    padding: 10px;
    border: 1px solid var(--border-alpha);
  }
  
  .nodo-toggle { 
    width: 18px; 
    height: 18px; 
    cursor: pointer;
    accent-color: var(--color-pink);
  }
  
  .nodo-label { 
    cursor: pointer;
    font-weight: bold;
  }
  
  .preguntas-container { 
    display: flex; 
    flex-direction: column; 
    gap: 15px;
  }
  
  .pregunta-item { 
    display: flex; 
    flex-direction: column; 
    gap: 5px;
  }
  
  .pregunta-label { 
    font-size: 0.8rem; 
    color: var(--color-dim);
  }
  
  .pregunta-input { 
    background: rgba(0, 0, 0, 0.3); 
    border: 1px solid var(--border-alpha); 
    color: var(--color-white); 
    padding: 10px; 
    font-family: var(--font-mono); 
    font-size: 0.9rem;
    resize: vertical;
  }
  
  .pregunta-input:focus { 
    outline: none; 
    border-color: var(--color-pink);
  }
  
  .btn-add-pregunta { 
    background: transparent; 
    border: 1px dashed var(--border-alpha); 
    color: var(--color-dim); 
    padding: 10px; 
    cursor: pointer; 
    font-family: var(--font-mono);
    transition: all 0.2s;
  }
  
  .btn-add-pregunta:hover { 
    border-color: var(--color-pink); 
    color: var(--color-pink);
  }
  
  .dimensiones-config { 
    display: grid; 
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); 
    gap: 20px;
  }
  
  .dimension-item { 
    display: flex; 
    flex-direction: column; 
    gap: 5px;
  }
  
  .dimension-item label { 
    font-size: 0.85rem; 
    color: var(--color-dim);
  }
  
  .dimension-item input { 
    background: rgba(0, 0, 0, 0.3); 
    border: 1px solid var(--border-alpha); 
    color: var(--color-white); 
    padding: 8px; 
    font-family: var(--font-mono);
  }
  
  .action-buttons { 
    display: flex; 
    gap: 15px; 
    justify-content: center; 
    margin: 30px 0;
    flex-wrap: wrap;
  }
  
  .btn-primary, .btn-secondary { 
    padding: 15px 30px; 
    font-family: var(--font-mono); 
    font-size: 0.9rem; 
    cursor: pointer; 
    border: 2px solid; 
    transition: all 0.2s;
    letter-spacing: 1px;
  }
  
  .btn-primary { 
    background: var(--color-pink); 
    border-color: var(--color-pink); 
    color: var(--color-black);
    font-weight: bold;
  }
  
  .btn-primary:hover { 
    background: transparent; 
    color: var(--color-pink);
  }
  
  .btn-secondary { 
    background: transparent; 
    border-color: var(--border-alpha); 
    color: var(--color-white);
  }
  
  .btn-secondary:hover { 
    border-color: var(--color-green-terminal); 
    color: var(--color-green-terminal);
  }
  
  .console-status { 
    border: 1px solid var(--border-alpha); 
    padding: 15px; 
    background: #050505; 
    font-family: var(--font-mono);
    max-height: 150px;
    overflow-y: auto;
  }
  
  .system-msg { 
    color: var(--color-green-terminal); 
    margin: 0;
  }
  
  .error-msg { color: #ff3333; }
  .info-msg { color: var(--color-pink); }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const consoleStatus = document.getElementById('consoleStatus');
    
    function log(msg, type = 'system') {
      const p = document.createElement('p');
      p.className = type === 'error' ? 'error-msg' : (type === 'info' ? 'info-msg' : 'system-msg');
      p.textContent = `> ${msg}`;
      consoleStatus.appendChild(p);
      consoleStatus.scrollTop = consoleStatus.scrollHeight;
    }

    // Guardar configuración
    document.getElementById('btn-guardar').addEventListener('click', async () => {
      log('Guardando configuración...', 'info');
      
      const config = {
        preguntas: {},
        nodos: [],
        dimensiones: {
          energia: {
            min: parseInt(document.getElementById('energia-min').value),
            max: parseInt(document.getElementById('energia-max').value)
          }
        }
      };

      // Recopilar nodos
      document.querySelectorAll('.nodo-toggle').forEach(checkbox => {
        config.nodos.push({
          id: checkbox.dataset.nodo,
          nombre: checkbox.nextElementSibling.textContent,
          activo: checkbox.checked
        });
      });

      // Recopilar preguntas
      document.querySelectorAll('.pregunta-item').forEach((item, index) => {
        const seccion = item.querySelector('.pregunta-input').dataset.seccion;
        if (!config.preguntas[seccion]) config.preguntas[seccion] = [];
        config.preguntas[seccion].push(item.querySelector('.pregunta-input').value);
      });

      try {
        const response = await fetch('/api/geist-config', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(config)
        });
        
        const result = await response.json();
        if (result.success) {
          log('✅ Configuración guardada exitosamente', 'system');
        } else {
          log('❌ Error al guardar: ' + result.message, 'error');
        }
      } catch (error) {
        log('❌ Error de conexión: ' + error.message, 'error');
      }
    });

    // Agregar pregunta
    document.querySelectorAll('.btn-add-pregunta').forEach(btn => {
      btn.addEventListener('click', () => {
        const seccion = btn.dataset.seccion;
        const container = btn.parentElement;
        const div = document.createElement('div');
        div.className = 'pregunta-item';
        div.innerHTML = `
          <label class="pregunta-label">Nueva Pregunta</label>
          <textarea class="pregunta-input" data-seccion="${seccion}" rows="2" placeholder="Escribe tu pregunta..."></textarea>
        `;
        container.insertBefore(div, btn);
        log(`+ Pregunta agregada en ${seccion}`, 'info');
      });
    });

    // Reset
    document.getElementById('btn-reset').addEventListener('click', () => {
      if (confirm('¿Restaurar configuración por defecto?')) {
        location.reload();
      }
    });

    // Exportar
    document.getElementById('btn-export').addEventListener('click', () => {
      log('📤 Exportando configuración...', 'info');
      // Implementación de exportación
    });
  });
</script>