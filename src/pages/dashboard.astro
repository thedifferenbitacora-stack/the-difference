---
import Layout from '../layouts/Layout.astro';
const API_URL = "https://script.google.com/macros/s/AKfycbz3pxN3R9xKt4-3gwySU-qBHYNKLVmbIuByzfCo_OfYyflIPB-Yrw3LLsnH8b--uFWV/exec";
let nodosData: any[] = [];
let modulosBIOS: any[] = [];
let bitacoraData: any[] = [];
let tareasData: any[] = [];
let systemStatus = "DISCONNECTED";
const fallbacks = {
nodos: [
{ id: "log", nombre: "LOG", link: "/log", status: "READY", icono: "📋" },
{ id: "le-tematik", nombre: "LE TEMATIK", link: "/le-tematik", status: "READY", icono: "🎵" },
{ id: "nada-brahma", nombre: "PROJECT NADA BRAHMA", link: "/nada-brahma", status: "ACTIVE", icono: "🕉️" },
{ id: "texvn", nombre: "TEXVN", link: "/texvn", status: "ONLINE", icono: "⚙️" },
{ id: "quantumlab", nombre: "QUANTUMLAB", link: "/quantumlab", status: "ONLINE", icono: "🧪" },
{ id: "pensamiento-autista", nombre: "PENSAMIENTO AUTISTA", link: "/pensamiento-autista", status: "ACTIVE", icono: "" },
{ id: "saiayin-do", nombre: "SAIAYIN DO", link: "/saiayin-do", status: "READY", icono: "⚔️" },
{ id: "ars-tekne", nombre: "ARS TEKNE", link: "/ars-tekne", status: "SECURE", icono: "️" },
{ id: "quiron-theatre", nombre: "QUIRÓN THEATRE", link: "/quiron-theatre", status: "READY", icono: "🎭" }
],
bios: [
{ id: "panel-edicion", nombre: "PANEL_EDICION_NUCLEO", status: "SYNC_EXCEL", type: "STORAGE_SESSION" },
{ id: "programacion-sistema", nombre: "PROGRAMACION_SISTEMA_BIOS", status: "ONLINE", type: "CORE_MODULE" },
{ id: "session-control", nombre: "PROP_SESSION_TOKEN", status: "ACTIVE", type: "AUTH_MODULE" },
{ id: "functional-backup", nombre: "BACKUP_FUNCTIONAL_HTML", status: "SECURE", type: "BACKUP_MODULE" }
]
};
nodosData = fallbacks.nodos;
modulosBIOS = fallbacks.bios;
if (API_URL && !API_URL.includes("PEGUE_AQUI") && API_URL.endsWith("/exec")) {
try {
const controller = new AbortController();
const timeoutId = setTimeout(() => controller.abort(), 5000);
const response = await fetch(API_URL, { method: 'GET', headers: { 'Accept': 'application/json' }, signal: controller.signal });
clearTimeout(timeoutId);
const rawText = await response.text();
if (rawText.trim().startsWith('{')) {
const json = JSON.parse(rawText);
if (json.success) {
nodosData = json.nodos?.length > 0 ? json.nodos : fallbacks.nodos;
modulosBIOS = json.modulosBIOS?.length > 0 ? json.modulosBIOS : fallbacks.bios;
bitacoraData = json.bitacora || [];
tareasData = json.tareas || [];
systemStatus = "ONLINE";
} else {
systemStatus = "API_ERROR";
}
} else {
systemStatus = "AUTH_REQUIRED";
}
} catch (error) {
systemStatus = "TIMEOUT_OR_OFFLINE";
}
} else {
systemStatus = API_URL.includes("PEGUE_AQUI") ? "CONFIG_PENDING" : "INVALID_URL";
}
---
<Layout title="The Difference - Dashboard BIOS">
<main class="dashboard-terminal">
<header class="terminal-header">
<div class="system-status-left">
<div class={`system-badge ${systemStatus.toLowerCase().replace(/_/g, '-')}`}>
<span class="pulse-dot"></span>
<span class="status-text">SYS: {systemStatus}</span>
</div>
</div>
<div class="brand">
<h1>THE DIFFERENCE</h1>
<p class="subtitle">MOOD GENIUS PLATFORM // SYSTEM LOG HUMAN</p>
</div>
<div class="header-spacer"></div>
</header>
<hr class="terminal-divider" />
<section class="texvn-recuadro">
<div class="panel-header-text">[ SECCIÓN COGNITIVA / TRIADA DIALÉCTICA ]</div>
<div class="triada-botones">
<button class="btn-ontologico" data-tipo="TESIS"><span class="btn-title">TESIS</span><span class="btn-subtext">Fenómeno Puro</span></button>
<button class="btn-ontologico" data-tipo="ANTÍTESIS"><span class="btn-title">ANTÍTESIS</span><span class="btn-subtext">Reacción / Código</span></button>
<button class="btn-ontologico" data-tipo="SÍNTESIS"><span class="btn-title">SÍNTESIS</span><span class="btn-subtext">Comprensión</span></button>
</div>
</section>
<section class="texvn-recuadro">
<div class="panel-header-text">[ NAVEGACIÓN DEL SISTEMA ]</div>
<div class="triada-botones">
<a href="/chat" class="btn-ontologico btn-nav">
<span class="btn-title">◈ CHAT IA</span>
<span class="btn-subtext">Asistente Autónomo</span>
</a>
<a href="/dashboard" class="btn-ontologico btn-nav active">
<span class="btn-title"> DASHBOARD</span>
<span class="btn-subtext">Panel Principal</span>
</a>
<a href="/planificacion" class="btn-ontologico btn-nav">
<span class="btn-title"> PANEL CONTROL</span>
<span class="btn-subtext">Planificación Diaria</span>
</a>
</div>
</section>
<section class="bios-grid">
<div class="bios-panel">
<div class="panel-header-text">[ CONFIGURACIÓN BIOS_CORE ]</div>
<div class="table-container">
<table class="terminal-table">
<thead><tr><th>MÓDULO</th><th>TIPO</th><th>ESTADO</th></tr></thead>
<tbody>
{modulosBIOS.map((modulo: any) => {
const validos = ["SYNC_EXCEL", "ONLINE", "READY", "SECURE", "ACTIVE"];
const clase = validos.includes(modulo.status) ? "active-green" : "status-error";
return (<tr><td class="mono">{modulo.nombre}</td><td class="dim">{modulo.type}</td><td class={`status-cell ${clase}`}>{modulo.status}</td></tr>);
})}
</tbody>
</table>
</div>
</div>
<div class="console-panel">
<div class="panel-header-text">[ CONSOLA DE ENTRADA ]</div>
<div class="console-box">
<div class="console-output" id="consoleOutput">
<p class="system-msg">> Sistema en espera...</p>
</div>
<div class="console-input-area">
<span class="prompt-char">&gt;</span>
<input type="text" id="terminalInput" placeholder="Escribe aquí..." disabled />
<button id="sendBtn" disabled>VOLCAR</button>
</div>
</div>
</div>
</section>
<section class="tareas-geist-panel">
<div class="panel-header-text">[ TAREAS GEIST // POSICIÓN EN EL PROCESO ]</div>
<div class="tareas-container">
{tareasData.length === 0 ? (
<p class="dim indent">> No hay tareas registradas en el meta-programa SYNC.</p>
) : (
tareasData.map((tarea: any) => (
<div class={`tarea-card ${String(tarea.estado).toLowerCase().replace(/ /g, '-')}`}>
<div class="tarea-header">
<span class="tarea-id">{tarea.id || 'SIN_ID'}</span>
<span class="tarea-nodo">{String(tarea.nodo || 'general').toUpperCase()}</span>
<span class={`tarea-estado ${String(tarea.estado).toLowerCase().replace(/ /g, '-')}`}>{tarea.estado}</span>
</div>
<div class="tarea-title">{tarea.titulo}</div>
<div class="tarea-dimensiones">
<div class="dimension"><span class="dim-label">ESPACIO:</span><span class="dim-value">{tarea.espacio || '-'}</span></div>
<div class="dimension"><span class="dim-label">TIEMPO:</span><span class="dim-value">{tarea.tiempo || '-'}</span></div>
<div class="dimension"><span class="dim-label">ENERGÍA:</span><span class="dim-value">{tarea.energia || '-'}</span></div>
<div class="dimension"><span class="dim-label">HÁBITO:</span><span class="dim-value">{tarea.habito || '-'}</span></div>
</div>
<div class="tarea-correccion">
<div class="correccion-item">
<span class="correccion-label">ARTE:</span>
<span class={tarea.arte ? 'text-green' : 'text-red'}>{tarea.arte ? '✓ ALINEADO' : '✗ DESVIADO'}</span>
</div>
<div class="correccion-item">
<span class="correccion-label">VALOR:</span>
<span class={tarea.valor ? 'text-green' : 'text-red'}>{tarea.valor ? '✓ APORTE' : ' RUIDO'}</span>
</div>
</div>
</div>
))
)}
</div>
</section>
<section class="scroll-panel-nodos">
<div class="panel-header-text">[ NODOS DE PROYECTOS ]</div>
<div class="scroll-container">
{nodosData.map((nodo: any) => (
<a href={nodo.link} class="nodo-row" id={nodo.id}>
<div class="nodo-meta"><span class="nodo-icon">{nodo.icono || '•'}</span><span class="nodo-name">{nodo.nombre}</span></div>
<div class="nodo-line-divider"></div>
<div class="nodo-status"><span class="status-lbl">STATUS:</span><span class="status-val">{nodo.status || 'ONLINE'}</span></div>
</a>
))}
</div>
</section>
<section class="bitacora-global-panel">
<div class="panel-header-text">[ BITÁCORA GLOBAL ]</div>
<div class="bitacora-stream">
{bitacoraData.length === 0 ? (
<p class="dim indent">> No hay registros recientes.</p>
) : (
bitacoraData.map((entrada: any) => (
<div class="bitacora-entry">
<span class="entry-time">[{entrada.timestamp}]</span>
<span class="entry-proj">[{entrada.proyecto}]</span>
<span class="entry-type">[{entrada.tipo}]:</span>
<span class="entry-content">{entrada.contenido}</span>
<span class="entry-user">~ {entrada.usuario}</span>
</div>
))
)}
</div>
</section>
</main>
</Layout>
<style>
:root {
--color-black: #000000;
--color-white: #ffffff;
--color-pink: #ff3e96;
--color-green-terminal: #00ff00;
--color-red: #ff3333;
--color-dim: #555555;
--border-alpha: rgba(255, 255, 255, 0.15);
--font-mono: 'Courier New', Courier, monospace;
--font-sans: 'Impact', 'Arial Black', sans-serif;
}
body { background-color: var(--color-black) !important; color: var(--color-white); margin: 0; padding: 0; padding-top: 0 !important; }
.dashboard-terminal {
font-family: var(--font-mono);
background-color: var(--color-black);
padding: 20px;
max-width: 1400px;
margin: 0 auto;
display: flex;
flex-direction: column;
gap: 20px;
box-sizing: border-box;
}
.terminal-divider { border: 0; border-top: 1px solid var(--border-alpha); margin: 0; width: 100%; }
.panel-header-text { font-size: 0.8rem; color: var(--color-white); letter-spacing: 2px; margin-bottom: 10px; font-weight: bold; }
.terminal-header {
display: flex;
justify-content: space-between;
align-items: center;
flex-wrap: wrap;
gap: 15px;
margin-bottom: 20px;
}
.system-status-left { flex-shrink: 0; min-width: 150px; }
.brand { text-align: center; flex: 1; }
.brand h1 { font-family: var(--font-sans); font-size: 2.8rem; margin: 0; letter-spacing: 2px; line-height: 1; text-align: center; }
.subtitle { margin: 5px 0 0 0; font-size: 0.85rem; color: var(--color-white); letter-spacing: 1px; text-align: center; }
.header-spacer { min-width: 150px; }
.system-badge { display: flex; align-items: center; gap: 10px; border: 1px solid var(--border-alpha); padding: 8px 16px; font-size: 0.85rem; font-weight: bold; white-space: nowrap; }
.system-badge.online { border-color: var(--color-green-terminal); color: var(--color-green-terminal); }
.system-badge.disconnected, .system-badge.api-error, .system-badge.auth-required, .system-badge.timeout-or-offline, .system-badge.config-pending, .system-badge.invalid-url { border-color: #ff3333; color: #ff3333; }
.pulse-dot { width: 8px; height: 8px; border-radius: 50%; background-color: currentColor; box-shadow: 0 0 8px currentColor; }
.status-text { letter-spacing: 1px; }
.texvn-recuadro { border: 1px solid var(--border-alpha); padding: 15px; }
.triada-botones { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 10px; }
.btn-ontologico {
background: transparent;
border: 1px solid var(--color-white);
color: var(--color-white);
padding: 15px;
cursor: pointer;
font-family: var(--font-mono);
text-align: left;
display: flex;
flex-direction: column;
gap: 5px;
transition: all 0.2s ease;
text-decoration: none;
}
.btn-ontologico:hover, .btn-ontologico.active {
background-color: var(--color-pink);
border-color: var(--color-pink);
color: var(--color-black);
}
.btn-title { font-family: var(--font-sans); font-size: 1.4rem; letter-spacing: 1px; }
.btn-subtext { font-size: 0.75rem; opacity: 0.8; }
.bios-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(500px, 1fr)); gap: 20px; }
.bios-panel, .console-panel { border: 1px solid var(--border-alpha); padding: 15px; display: flex; flex-direction: column; }
.table-container { overflow-x: auto; width: 100%; }
.terminal-table { width: 100%; border-collapse: collapse; text-align: left; font-size: 0.85rem; }
.terminal-table th { border-bottom: 1px solid var(--color-white); padding: 10px 8px; font-weight: bold; color: var(--color-white); }
.terminal-table td { padding: 12px 8px; border-bottom: 1px solid var(--border-alpha); }
.terminal-table tbody tr:hover { background-color: var(--color-pink); color: var(--color-black); }
.mono { font-family: var(--font-mono); }
.dim { color: var(--color-dim); }
.active-green { color: var(--color-green-terminal); font-weight: bold; }
.status-error { color: #ff3333; font-weight: bold; }
.console-box { flex-grow: 1; display: flex; flex-direction: column; background-color: #050505; border: 1px solid var(--border-alpha); }
.console-output { padding: 15px; min-height: 120px; max-height: 150px; overflow-y: auto; font-size: 0.85rem; line-height: 1.4; border-bottom: 1px solid var(--border-alpha); }
.system-msg { color: var(--color-green-terminal); margin: 0; }
.user-msg { color: var(--color-white); margin: 5px 0 0 0; }
.console-input-area { display: flex; align-items: center; padding: 10px; gap: 10px; }
.prompt-char { color: var(--color-pink); font-weight: bold; }
.console-input-area input { flex-grow: 1; background: transparent; border: none; color: var(--color-white); font-family: var(--font-mono); font-size: 0.85rem; outline: none; }
.console-input-area input:disabled { cursor: not-allowed; opacity: 0.5; }
.console-input-area button { background: transparent; border: 1px solid var(--color-white); color: var(--color-white); font-family: var(--font-mono); font-size: 0.75rem; padding: 5px 15px; cursor: pointer; }
.console-input-area button:hover:not(:disabled) { background-color: var(--color-white); color: var(--color-black); }
.console-input-area button:disabled { opacity: 0.3; cursor: not-allowed; }
.tareas-geist-panel { border: 1px solid var(--border-alpha); padding: 15px; }
.tareas-container { max-height: 500px; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; padding-right: 5px; }
.tareas-container::-webkit-scrollbar { width: 6px; }
.tareas-container::-webkit-scrollbar-thumb { background: var(--border-alpha); border-radius: 3px; }
.tarea-card { border: 1px solid var(--border-alpha); padding: 15px; background: rgba(255, 255, 255, 0.02); transition: all 0.2s ease; }
.tarea-card:hover { border-color: var(--color-pink); background: rgba(255, 62, 150, 0.05); }
.tarea-card.completada { border-left: 3px solid var(--color-green-terminal); }
.tarea-card.corregida { border-left: 3px solid var(--color-pink); }
.tarea-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; flex-wrap: wrap; gap: 10px; }
.tarea-id { font-size: 0.75rem; color: var(--color-dim); }
.tarea-nodo { font-size: 0.8rem; color: var(--color-pink); font-weight: bold; }
.tarea-estado { font-size: 0.7rem; padding: 2px 8px; border: 1px solid currentColor; }
.tarea-estado.en_proceso { color: var(--color-green-terminal); }
.tarea-estado.pendiente { color: var(--color-dim); }
.tarea-estado.completada { color: var(--color-green-terminal); }
.tarea-title { font-size: 1rem; font-weight: bold; margin-bottom: 10px; color: var(--color-white); }
.tarea-dimensiones { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px; margin-bottom: 10px; }
.dimension { display: flex; gap: 5px; font-size: 0.75rem; }
.dim-label { color: var(--color-dim); }
.dim-value { color: var(--color-white); }
.tarea-correccion { display: flex; gap: 20px; padding-top: 10px; border-top: 1px solid var(--border-alpha); }
.correccion-item { display: flex; gap: 8px; font-size: 0.8rem; }
.correccion-label { color: var(--color-dim); }
.text-green { color: var(--color-green-terminal); font-weight: bold; }
.text-red { color: var(--color-red); font-weight: bold; }
.scroll-panel-nodos { border: 1px solid var(--border-alpha); padding: 15px; }
.scroll-container { max-height: 450px; overflow-y: auto; display: flex; flex-direction: column; gap: 4px; padding-right: 5px; }
.scroll-container::-webkit-scrollbar { width: 6px; }
.scroll-container::-webkit-scrollbar-track { background: var(--color-black); }
.scroll-container::-webkit-scrollbar-thumb { background: var(--border-alpha); border-radius: 3px; }
.scroll-container::-webkit-scrollbar-thumb:hover { background: var(--color-pink); }
.nodo-row { display: flex; align-items: center; justify-content: space-between; padding: 14px 10px; text-decoration: none; color: var(--color-white); border-bottom: 1px solid rgba(255, 255, 255, 0.05); transition: background 0.1s ease; }
.nodo-row:hover { background-color: var(--color-pink) !important; color: var(--color-black) !important; }
.nodo-meta { display: flex; align-items: center; gap: 12px; min-width: 240px; }
.nodo-icon { font-size: 1.1rem; }
.nodo-name { font-family: var(--font-sans); font-size: 1.25rem; letter-spacing: 1px; }
.nodo-line-divider { flex-grow: 1; border-bottom: 1px dotted var(--border-alpha); margin: 0 20px; height: 1px; }
.nodo-row:hover .nodo-line-divider { border-bottom-color: var(--color-black); }
.nodo-status { display: flex; gap: 8px; font-size: 0.8rem; }
.status-lbl { opacity: 0.6; }
.nodo-row:hover .status-lbl { opacity: 1; }
.status-val { font-weight: bold; color: var(--color-green-terminal); }
.nodo-row:hover .status-val { color: var(--color-black); }
.bitacora-global-panel { border: 1px solid var(--border-alpha); padding: 15px; }
.bitacora-stream { max-height: 250px; overflow-y: auto; font-size: 0.8rem; display: flex; flex-direction: column; gap: 8px; }
.bitacora-entry { padding: 4px 0; line-height: 1.4; border-bottom: 1px solid rgba(255, 255, 255, 0.02); }
.entry-time { color: var(--color-dim); margin-right: 5px; }
.entry-proj { color: var(--color-pink); font-weight: bold; margin-right: 5px; }
.entry-type { color: var(--color-green-terminal); margin-right: 8px; }
.entry-content { color: var(--color-white); }
.entry-user { color: var(--color-dim); font-size: 0.75rem; margin-left: 10px; }
@media (max-width: 768px) {
.terminal-header { flex-direction: column; text-align: center; }
.header-spacer { display: none; }
.brand h1 { font-size: 2rem; }
.system-status-left { margin-bottom: 10px; }
}
</style>
<script define:vars={{ API_URL }}>
const botones = document.querySelectorAll('.btn-ontologico');
const termInput = document.getElementById('terminalInput');
const sendBtn = document.getElementById('sendBtn');
const consoleOutput = document.getElementById('consoleOutput');
let loopSeleccionado = "";
botones.forEach(btn => {
btn.addEventListener('click', () => {
botones.forEach(b => b.classList.remove('active'));
btn.classList.add('active');
loopSeleccionado = btn.getAttribute('data-tipo');
termInput.disabled = false;
sendBtn.disabled = false;
termInput.placeholder = `Escribe para ${loopSeleccionado}...`;
termInput.focus();
imprimirEnConsola(`> Bucle fijado: [${loopSeleccionado}]`, 'system');
});
});
sendBtn.addEventListener('click', ejecutarEnvio);
termInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') ejecutarEnvio(); });
async function ejecutarEnvio() {
const texto = termInput.value.trim();
if (!texto || !loopSeleccionado) return;
termInput.disabled = true;
sendBtn.disabled = true;
imprimirEnConsola(`> Transmitiendo a BIOS...`, 'system');
try {
const payload = { action: "bitacora", proyecto: "QUANTUM LAB", tipo: loopSeleccionado, contenido: texto, usuario: "Operador" };
const response = await fetch(API_URL, { method: 'POST', headers: { 'Content-Type': 'text/plain;charset=utf-8' }, body: JSON.stringify(payload) });
const result = await response.json();
if (result.success) {
imprimirEnConsola(`+ [ÉXITO] Registro guardado en BITÁCORA GLOBAL.`, 'success');
termInput.value = "";
} else {
imprimirEnConsola(`- [ERROR BIOS] ${result.message || 'Fallo en escritura'}`, 'error');
}
} catch (err) {
imprimirEnConsola(`- [FALLA DE RED] ${err.message}. Activando modo local.`, 'error');
} finally {
termInput.disabled = false;
sendBtn.disabled = false;
termInput.focus();
}
}
function imprimirEnConsola(msg: string, type: string = 'user') {
const p = document.createElement('p');
p.className = type === 'system' ? 'system-msg' : (type === 'error' ? 'status-error' : 'user-msg');
p.textContent = msg;
consoleOutput.appendChild(p);
consoleOutput.scrollTop = consoleOutput.scrollHeight;
}
</script>