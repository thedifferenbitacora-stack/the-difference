---
import Base from '../layouts/Base.astro';
---

<Base title="Quantum Core // Dashboard">
    <div style="padding: 20px;"><a href="/">VOLVER A INICIO</a></div>
    <h1>QUANTUM CORE // DASHBOARD</h1>
    
    <div class="grid">
        <div class="box">
            <div class="header">[01] TÉCNICO // RESPALDO</div>
            <button id="btn-backup" style="width: 100%;">EJECUTAR RESPALDO // ANTÍTESIS</button>
            <div id="log-tech" style="margin-top: 15px;"></div>
        </div>
    </div>

    <script>
        const btnBackup = document.getElementById('btn-backup') as HTMLButtonElement;
        const logTech = document.getElementById('log-tech') as HTMLElement;

        btnBackup?.addEventListener('click', async () => {
            logTech.innerHTML = "<p>> Procesando Antítesis...</p>";
            btnBackup.innerText = "ESPERANDO...";
            
            try {
                const res = await fetch('/api/backup', { method: 'POST' });
                const data = await res.json();
                
                if (res.ok && data.success) {
                    logTech.innerHTML = "<p style='color: #32cd32'>> ANTÍTESIS COMPLETA. LISTO PARA SÍNTESIS.</p>";
                } else {
                    logTech.innerHTML = `<p style='color: red'>> Error: ${data.error || 'Falla de conexión'}</p>`;
                }
            } catch (e) {
                logTech.innerHTML = "<p style='color: red'>> Error crítico en la red.</p>";
            } finally {
                btnBackup.innerText = "EJECUTAR RESPALDO // ANTÍTESIS";
            }
        });
    </script>
</Base>