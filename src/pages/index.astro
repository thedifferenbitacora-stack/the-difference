<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FEELING AUTISTIC - THE DIFFERENCE</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    body {
      background: #000000;
      min-height: 100vh;
      font-family: Arial Black, sans-serif;
      overflow: hidden;
    }
    
    .main-container {
      position: relative;
      width: 100vw;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    
    /* IMAGEN DE FONDO - MÁS PEQUEÑA Y ARRIBA */
    .background-image {
      position: absolute;
      top: 45%;
      left: 50%;
      transform: translate(-50%, -75%);
      max-width: 90%;
      max-height: 60vh;
      width: auto;
      height: auto;
      z-index: 1;
    }
    
    /* BOTÓN THE DIFFERENCE - MÁS GRANDE Y JUSTO DEBAJO DE LA IMAGEN */
    .btn-difference {
      position: absolute;
      bottom: 350px;
      left: 48%;
      transform: translateX(-50%);
      font-size: 70px;
      font-weight: 900;
      color: #ffffff;
      text-transform: uppercase;
      letter-spacing: 7px;
      border: 3px solid #ffffff;
      padding: 30px 60px;
      background: transparent;
      z-index: 10;
      text-align: center;
      white-space: nowrap;
      text-decoration: none;
      cursor: pointer;
      display: inline-block;
      transition: all 0.3s ease;
    }
    
    .btn-difference:hover {
      background: rgba(255, 105, 180, 0);
      border-color: #ff69b4;
      color: #ff69b4;
      transform: translateX(-50%) scale(1.05);
      box-shadow: 0 0 30px rgba(255, 105, 180, 0.5);
    }
    
    /* BOTÓN LE TEMATIK */
    .btn-tematik {
      position: absolute;
      bottom: 60px;
      right: 80px;
      font-size: 18px;
      font-weight: 900;
      color: #fffc34;
      text-transform: uppercase;
      letter-spacing: 3px;
      border: 3px solid #ffffff;
      padding: 10px 25px;
      background: transparent;
      text-decoration: none;
      z-index: 10;
      cursor: pointer;
      display: inline-block;
      transition: all 0.3s ease;
    }
    
    .btn-tematik:hover {
      background: rgba(255, 215, 0, 0.1);
      transform: scale(1.05);
    }
    
    /* RESPONSIVE */
    @media (max-width: 768px) {
      .btn-difference {
        font-size: 28px;
        padding: 15px 30px;
        bottom: 140px;
      }
      
      .btn-tematik {
        font-size: 14px;
        padding: 8px 15px;
        right: 20px;
        bottom: 40px;
      }
    }
  </style>
</head>
<body>
  <div class="main-container">
    <!-- IMAGEN DE FONDO -->
    <img 
      src="/images/logo-feeling-autistic.png" 
      alt="FEELING AUTISTIC - Intuitive Analityc Neurodivergence Creative Platform"
      class="background-image"
    />
    
    <!-- BOTÓN THE DIFFERENCE -->
    <a href="/menu" class="btn-difference">
      THE DIFFERENCE
    </a>
    
    <!-- BOTÓN LE TEMATIK -->
    <a href="#" class="btn-tematik">
      LE TEMATIK DESIGN
    </a>
  </div>
</body>
</html>