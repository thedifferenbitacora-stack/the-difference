---
import Layout from '../layouts/Layout.astro';

const API_URL = "https://script.google.com/macros/s/AKfycbzhKBMHtONep5OliJXBNjz1yzphA-oddL2WmowNv7G4C2b5Vi-gkU2jX5C9JemkkoJ0/exec";

// Valores optimizados para presentación compacta
const defaults = {
  MAIN: { container: { padding_top: '80px', fade_duration: '1.2s', text_align: 'center', max_width: '900px', margin_auto: 'true' } },
  IMAGE: { 
    container: { width: '280px', height: '280px', margin_bottom: '25px', border_width: '3px', border_color: '#ffffff', border_radius: '50%', box_shadow: '0 0 40px rgba(255, 255, 255, 0.15)' }
  },
  TITLE: { h1: { text: 'FEELING AUSTISTIC', font_size: '4.5rem', letter_spacing: '0.2rem', margin_bottom: '8px', font_weight: 'normal', text_shadow: '0 0 20px rgba(255, 255, 255, 0.3)' } },
  SUBTITLE: { p: { text: 'Neurodivergence + Creative Philosophy + System Log Human + ARS TEKNE + AI', font_size: '1rem', color: '#e0e0e0', margin_bottom: '35px', letter_spacing: '0.08rem', line_height: '1.4' } },
  BUTTON_CONTAINER: { div: { margin_bottom: '35px', padding: '0 20px' } },
  BUTTON: { 
    link: { 
      text: 'THE DIFFERENCE', 
      href: '/menu', 
      border_width: '3px', 
      border_color: '#ffffff', 
      border_color_hover: '#ff3e96', 
      color: '#ffffff', 
      color_hover: '#ff3e96', 
      padding: '25px 60px', 
      font_size: '2rem', 
      letter_spacing: '0.3rem',
      display: 'inline-block',
      border_radius: '0px',
      background: 'transparent',
      font_weight: 'bold'
    } 
  },
  DESCRIPTION: { 
    container: { 
      max_width: '700px', 
      color: '#b0b0b0', 
      line_height: '1.7', 
      font_size: '0.9rem', 
      text_align: 'center',
      margin_top: '20px',
      padding: '20px 30px',
      background: 'rgba(255, 255, 255, 0.02)',
      border_left: '2px solid #ff3e96',
      border_right: '2px solid #ff3e96'
    } 
  }
};

let indexConfig = defaults;

try {
  const res = await fetch(API_URL + '?t=' + Date.now());
  const data = await res.json();
  
  if (data.success && data.indexConfig) {
    indexConfig = {
      MAIN: { ...defaults.MAIN, ...data.indexConfig.MAIN },
      IMAGE: {
        container: { ...defaults.IMAGE.container, ...(data.indexConfig.IMAGE?.container || {}) }
      },
      TITLE: { h1: { ...defaults.TITLE.h1, ...(data.indexConfig.TITLE?.h1 || {}) } },
      SUBTITLE: { p: { ...defaults.SUBTITLE.p, ...(data.indexConfig.SUBTITLE?.p || {}) } },
      BUTTON_CONTAINER: { div: { ...defaults.BUTTON_CONTAINER.div, ...(data.indexConfig.BUTTON_CONTAINER?.div || {}) } },
      BUTTON: { link: { ...defaults.BUTTON.link, ...(data.indexConfig.BUTTON?.link || {}) } },
      DESCRIPTION: { container: { ...defaults.DESCRIPTION.container, ...(data.indexConfig.DESCRIPTION?.container || {}) } }
    };
  }
} catch (e) {
  console.error("Usando configuración por defecto", e);
}

const c = indexConfig;
---

<Layout title="THE DIFFERENCE // INICIO">
  <main class="index-main" style={`padding-top: ${c.MAIN.container.padding_top}; animation: fadeIn ${c.MAIN.container.fade_duration} ease-in; text-align: ${c.MAIN.container.text_align}; max-width: ${c.MAIN.container.max_width || '900px'}; margin: ${c.MAIN.container.margin_auto === 'true' ? '0 auto' : '0'};`}>
    
    <header class="index-header">
      <button class="btn-nav" id="audio-btn">♪ ON</button>
      <a href="/dashboard" class="btn-nav">DASHBOARD</a>
    </header>

    <div class="visual-identity">
      <!-- Imagen con borde y sombra -->
      <div class="image-container" style={`width: ${c.IMAGE.container.width}; height: ${c.IMAGE.container.height}; margin: 0 auto ${c.IMAGE.container.margin_bottom}; overflow: hidden; border: ${c.IMAGE.container.border_width} solid ${c.IMAGE.container.border_color}; border-radius: ${c.IMAGE.container.border_radius}; box-shadow: ${c.IMAGE.container.box_shadow || 'none'};`}>
        <img src="/assets/pensador.jpg" alt="Pensador" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
      </div>
      
      <!-- Título principal -->
      <h1 class="main-title" style={`font-size: ${c.TITLE.h1.font_size}; letter-spacing: ${c.TITLE.h1.letter_spacing}; margin-bottom: ${c.TITLE.h1.margin_bottom}; font-weight: ${c.TITLE.h1.font_weight}; text-transform: uppercase; text-shadow: ${c.TITLE.h1.text_shadow || 'none'};`}>
        {c.TITLE.h1.text}
      </h1>
      
      <!-- Subtítulo compacto -->
      <p class="main-subtitle" style={`font-size: ${c.SUBTITLE.p.font_size}; color: ${c.SUBTITLE.p.color}; margin-bottom: ${c.SUBTITLE.p.margin_bottom}; letter-spacing: ${c.SUBTITLE.p.letter_spacing}; line-height: ${c.SUBTITLE.p.line_height || '1.4'}; max-width: 800px; margin-left: auto; margin-right: auto;`}>
        {c.SUBTITLE.p.text}
      </p>
      
      <!-- Botón principal con bordes ajustados -->
      <div class="button-container" style={`margin-bottom: ${c.BUTTON_CONTAINER.div.margin_bottom}; padding: ${c.BUTTON_CONTAINER.div.padding || '0'};`}>
        <a href={c.BUTTON.link.href} 
           class="main-button"
           data-hover-border={c.BUTTON.link.border_color_hover}
           data-hover-color={c.BUTTON.link.color_hover}
           style={`border: ${c.BUTTON.link.border_width} solid ${c.BUTTON.link.border_color}; color: ${c.BUTTON.link.color}; padding: ${c.BUTTON.link.padding}; font-size: ${c.BUTTON.link.font_size}; letter-spacing: ${c.BUTTON.link.letter_spacing}; display: ${c.BUTTON.link.display}; background: ${c.BUTTON.link.background || 'transparent'}; font-weight: ${c.BUTTON.link.font_weight || 'bold'}; border-radius: ${c.BUTTON.link.border_radius || '0'}; transition: all 0.3s ease;`}>
           {c.BUTTON.link.text}
        </a>
      </div>

      <!-- Descripción integrada y compacta -->
      <div class="description-container" style={`max-width: ${c.DESCRIPTION.container.max_width}; color: ${c.DESCRIPTION.container.color}; line-height: ${c.DESCRIPTION.container.line_height}; font-size: ${c.DESCRIPTION.container.font_size}; text-align: ${c.DESCRIPTION.container.text_align}; margin: ${c.DESCRIPTION.container.margin_top || '20px'} auto 0; padding: ${c.DESCRIPTION.container.padding || '20px 30px'}; background: ${c.DESCRIPTION.container.background || 'rgba(255, 255, 255, 0.02)'}; border-left: ${c.DESCRIPTION.container.border_left || '2px solid #ff3e96'}; border-right: ${c.DESCRIPTION.container.border_right || '2px solid #ff3e96'};`}>
        <p style="margin-bottom: 1rem; font-weight: 300;">Neurodivergence + Creative Philosophy + System Log Human + ARS TEKNE + AI</p>
        <p style="margin-bottom: 1rem; line-height: 1.8;">QuantumLab es un laboratorio donde convergen filosofía, arte, tecnología e IA para explorar nuevas formas de comprender la experiencia humana.</p>
        <p style="margin-bottom: 1rem; line-height: 1.8;">Su fundamento es el Pensamiento Autista como modelo epistemológico que privilegia la observación profunda, el reconocimiento de patrones y la creación de sistemas.</p>
        <p style="margin-bottom: 1rem; line-height: 1.8;">La tecnología se convierte en extensión del pensamiento, la sensibilidad y la imaginación desde ARS TEKNE.</p>
        <p style="margin-bottom: 0; font-style: italic; opacity: 0.9;">Buscamos ampliar la conciencia mediante sistemas creativos.</p>
      </div>
    </div>

  </main>
</Layout>

<style>
  :root { --bg-dark: #000000; --text-white: #ffffff; --punk-pink: #ff3e96; --font-mono: 'Courier New', Courier, monospace; }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background-color: var(--bg-dark); color: var(--text-white); font-family: var(--font-mono); }

  .index-main { display: flex; flex-direction: column; align-items: center; min-height: 100vh; padding-left: 20px; padding-right: 20px; padding-bottom: 60px; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

  .index-header { position: absolute; top: 30px; right: 30px; display: flex; gap: 15px; z-index: 40; }
  .btn-nav { background: transparent; border: 1px solid var(--text-white); color: var(--text-white); padding: 8px 16px; font-family: var(--font-mono); font-size: 14px; cursor: pointer; text-decoration: none; transition: all 0.3s ease; }
  .btn-nav:hover { border-color: var(--punk-pink); color: var(--punk-pink); }

  .visual-identity { display: flex; flex-direction: column; align-items: center; width: 100%; }

  .image-container {
    width: 280px;
    height: 280px;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid #ffffff;
    box-shadow: 0 0 40px rgba(255, 255, 255, 0.15);
    margin: 0 auto 25px;
  }

  .image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .main-title { 
    font-weight: normal; 
    text-transform: uppercase; 
    color: var(--text-white); 
    text-align: center;
    text-shadow: 0 0 20px rgba(255, 255, 255, 0.3);
  }
  
  .main-subtitle { 
    text-transform: uppercase; 
    font-weight: normal; 
    text-align: center;
    color: #e0e0e0;
    letter-spacing: 0.08rem;
    line-height: 1.4;
  }
  
  .main-button { 
    text-decoration: none; 
    font-weight: bold; 
    transition: all 0.3s ease;
    border: 3px solid #ffffff;
    background: transparent;
  }

  .main-button:hover {
    border-color: var(--punk-pink);
    color: var(--punk-pink);
    box-shadow: 0 0 40px rgba(255, 62, 150, 0.5);
    transform: translateY(-2px);
  }

  .description-container {
    max-width: 700px;
    color: #b0b0b0;
    line-height: 1.7;
    font-size: 0.9rem;
    text-align: center;
    margin: 20px auto 0;
    padding: 20px 30px;
    background: rgba(255, 255, 255, 0.02);
    border-left: 2px solid #ff3e96;
    border-right: 2px solid #ff3e96;
  }

  .description-container p {
    margin-bottom: 1rem;
    font-weight: 300;
  }

  @media (max-width: 768px) {
    .main-title { font-size: 2.5rem !important; letter-spacing: 0.1rem !important; }
    .main-subtitle { font-size: 0.85rem !important; }
    .main-button { padding: 20px 40px !important; font-size: 1.5rem !important; letter-spacing: 0.15rem !important; }
    .index-header { top: 15px; right: 15px; }
    .image-container { width: 200px; height: 200px; }
    .description-container { padding: 15px 20px !important; font-size: 0.85rem !important; }
  }
</style>

<script is:inline>
  const btn = document.getElementById('audio-btn');
  btn?.addEventListener('click', () => { btn.textContent = btn.textContent === '♪ ON' ? '♪ OFF' : '♪ ON'; });
</script>