---
import Layout from '../layouts/Layout.astro';

const nodos = [
    { nombre: "LOG", link: "/log" },
    { nombre: "LE TEMATIK", link: "/le-tematik" },
    { nombre: "PROJECT NADA BRAHMA", link: "/nada-brahma" },
    { nombre: "TEXVN", link: "/texvn" },
    { nombre: "QUANTUMLAB", link: "/quantumlab" },
    { nombre: "PENSAMIENTO AUTISTA", link: "/pensamiento-autista" },
    { nombre: "SAIAYIN DO", link: "/saiayin-do" },
    { nombre: "ARS TEKNE", link: "/ars-tekne" },
    { nombre: "QUIRÓN THEATRE", link: "/quiron-theatre" }
];
---

<Layout>
    <!-- Contenedor principal sin elementos extra en las esquinas -->
    <main style="display: flex; flex-direction: column; align-items: center; min-height: 100vh; padding: 60px 20px; font-family: 'Courier New', monospace; background-color: #000; margin: 0;">
        
        <!-- Botón Principal de Retorno -->
        <a href="/" 
           style="border: 3px solid #ff3e96; color: #ff3e96; padding: 40px 80px; font-size: 2.5rem; font-weight: bold; text-decoration: none; margin-bottom: 60px; transition: 0.3s; letter-spacing: 0.2rem;"
           onmouseover="this.style.backgroundColor='#ff3e96'; this.style.color='#000';" 
           onmouseout="this.style.backgroundColor='transparent'; this.style.color='#ff3e96';">
           THE DIFFERENCE
        </a>

        <!-- Grid de 9 Nodos -->
        <div style="display: flex; flex-direction: column; align-items: center; gap: 20px; width: 100%; max-width: 900px;">
            <div style="display: flex; gap: 20px;">
                {nodos.slice(0, 4).map(n => <a href={n.link} style="border: 2px solid #fff; color: #ffff00; padding: 20px 30px; font-weight: bold; text-decoration: none; min-width: 150px; text-align: center;">{n.nombre}</a>)}
            </div>
            <div style="display: flex; gap: 20px;">
                {nodos.slice(4, 7).map(n => <a href={n.link} style="border: 2px solid #fff; color: #ffff00; padding: 20px 30px; font-weight: bold; text-decoration: none; min-width: 150px; text-align: center;">{n.nombre}</a>)}
            </div>
            <div style="display: flex; gap: 20px;">
                {nodos.slice(7, 9).map(n => <a href={n.link} style="border: 2px solid #fff; color: #ffff00; padding: 20px 30px; font-weight: bold; text-decoration: none; min-width: 150px; text-align: center;">{n.nombre}</a>)}
            </div>
        </div>
    </main>
</Layout>