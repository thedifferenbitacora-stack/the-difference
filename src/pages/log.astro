---
import Layout from '../layouts/Layout.astro';
import MenuReturn from '../components/MenuReturn.astro';

const API_URL = "PEGUE_AQUI_LA_URL_DE_LA_APLICACION_WEB";
let systemStatus = "DISCONNECTED";

if (API_URL && !API_URL.includes("PEGUE_AQUI") && API_URL.endsWith("/exec")) {
  try {
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), 5000);
    const response = await fetch(API_URL, { 
      method: 'GET', 
      headers: { 'Accept': 'application/json' }, 
      signal: controller.signal 
    });
    clearTimeout(timeoutId);
    const rawText = await response.text();
    
    if (rawText.trim().startsWith('{')) {
      const json = JSON.parse(rawText);
      if (json.success) systemStatus = "ONLINE";
    }
  } catch (error) {
    systemStatus = "OFFLINE";
  }
}
---

<Layout title="ARS_TEKNE // LOG: ARCHIVO BIODINÁMICO">
  
  <MenuReturn href="/menu" label="THE DIFFERENCE" />

  <main class="log-terminal">
    <header class="log-header">
      <div class="brand">
        <h1>LOG_VITAL</h1>
        <p class="subtitle">ARCHIVO BIODINÁMICO // EVOLUCIÓN DEL INDIVIDUO INVESTIGADOR</p>
      </div>
      <div class={systemStatus === "ONLINE" ? "system-badge online" : "system-badge offline"}>
        <span class="pulse-dot"></span>
        <span class="status-text">SYS_STATUS: {systemStatus}</span>
      </div>
    </header>

    <hr class="terminal-divider" />

    <section class="manifesto-log">
      <div class="panel-header-text">[ PREMISA ONTOLÓGICA ]</div>
      <p class="log-text">
        Esta no es una bitácora de taller convencional. Es el modelo de una vida comprendida. 
        Es la historia de un individuo que se desarrolla e investiga en su propio taller.
      </p>
    </section>

    <section class="stage-section origen">
      <div class="stage-header">
        <span class="stage-number">01</span>
        <h2>NIÑEZ: EL ORIGEN Y EL CONTEXTO</h2>
      </div>
      <div class="stage-content">
        <p>La materia prima. El entorno fundacional donde se establecen las primeras coordenadas del ser.</p>
        <div class="data-block">
          <span class="label">ESTADO:</span> <span class="value">Recepción Pasiva / Configuración Inicial</span>
        </div>
      </div>
    </section>

    <section class="stage-section juventud">
      <div class="stage-header">
        <span class="stage-number">02</span>
        <h2>JUVENTUD: LA FRICCIÓN Y LA EXPLORACIÓN</h2>
      </div>
      <div class="stage-content">
        <p>La segunda etapa. El despertar del criterio propio.</p>
        <div class="data-block">
          <span class="label">ESTADO:</span> <span class="value">Exploración Activa / Formación del Criterio</span>
        </div>
      </div>
    </section>

    <section class="stage-section adultez">
      <div class="stage-header">
        <span class="stage-number">03</span>
        <h2>ADULTEZ: POSICIÓN DIALÉCTICA</h2>
      </div>
      <div class="stage-content">
        <p>La síntesis operativa desde el taller.</p>
        <div class="cuatro-centros">
          <div class="panel-header-text" style="margin-top: 20px;">[ LOS 4 CENTROS DE DESARROLLO ]</div>
          <div class="centros-grid">
            <div class="centro-card"><h3>CENTRO I</h3><p class="centro-desc">Cognitivo</p></div>
            <div class="centro-card"><h3>CENTRO II</h3><p class="centro-desc">Emocional</p></div>
            <div class="centro-card"><h3>CENTRO III</h3><p class="centro-desc">Físico</p></div>
            <div class="centro-card"><h3>CENTRO IV</h3><p class="centro-desc">Trascendente</p></div>
          </div>
        </div>
      </div>
    </section>

    <footer class="log-footer">
      <p class="dim">ARS_TEKNE v1.0</p>
    </footer>
  </main>
</Layout>

<style>
  :root { --color-black: #000000; --color-white: #ffffff; --color-pink: #ff3e96; --color-green-terminal: #00ff00; --color-dim: #555555; --border-alpha: rgba(255, 255, 255, 0.15); --font-mono: 'Courier New', Courier, monospace; --font-sans: 'Impact', 'Arial Black', sans-serif; }
  body { background-color: var(--color-black) !important; color: var(--color-white); margin: 0; padding: 0; }
  .log-terminal { font-family: var(--font-mono); background-color: var(--color-black); padding: 20px; max-width: 1000px; margin: 0 auto; display: flex; flex-direction: column; gap: 30px; box-sizing: border-box; min-height: 100vh; }
  .terminal-divider { border: 0; border-top: 1px solid var(--border-alpha); margin: 0; width: 100%; }
  .panel-header-text { font-size: 0.8rem; color: var(--color-white); letter-spacing: 2px; margin-bottom: 10px; font-weight: bold; border-left: 3px solid var(--color-pink); padding-left: 10px; }
  .log-header { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; }
  .brand h1 { font-family: var(--font-sans); font-size: 3.5rem; margin: 0; letter-spacing: 2px; line-height: 1; color: var(--color-white); }
  .subtitle { margin: 5px 0 0 0; font-size: 0.85rem; color: var(--color-green-terminal); letter-spacing: 1px; }
  .system-badge { display: flex; align-items: center; gap: 10px; border: 1px solid var(--border-alpha); padding: 8px 16px; font-size: 0.85rem; font-weight: bold; }
  .system-badge.online { border-color: var(--color-green-terminal); color: var(--color-green-terminal); }
  .system-badge.offline { border-color: #ff3333; color: #ff3333; }
  .pulse-dot { width: 8px; height: 8px; border-radius: 50%; background-color: currentColor; box-shadow: 0 0 8px currentColor; }
  .manifesto-log { border: 1px solid var(--border-alpha); padding: 20px; background: rgba(255, 255, 255, 0.02); }
  .log-text { font-size: 1.1rem; line-height: 1.8; color: #cccccc; }
  .highlight { color: var(--color-pink); font-weight: bold; }
  .stage-section { border: 1px solid var(--border-alpha); padding: 25px; }
  .stage-header { display: flex; align-items: center; gap: 15px; margin-bottom: 15px; border-bottom: 1px solid var(--border-alpha); padding-bottom: 10px; }
  .stage-number { font-family: var(--font-sans); font-size: 2rem; color: var(--color-dim); }
  .stage-header h2 { margin: 0; font-size: 1.5rem; letter-spacing: 1px; }
  .stage-content p { line-height: 1.7; color: #aaaaaa; margin-bottom: 15px; }
  .data-block { background: #0a0a0a; padding: 10px 15px; border-left: 2px solid var(--color-green-terminal); font-size: 0.9rem; }
  .data-block .label { color: var(--color-dim); margin-right: 10px; }
  .data-block .value { color: var(--color-white); font-weight: bold; }
  .cuatro-centros { margin-top: 20px; }
  .centros-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-top: 15px; }
  .centro-card { border: 1px solid var(--border-alpha); padding: 15px; text-align: center; }
  .centro-card h3 { margin: 0 0 10px 0; font-size: 1.1rem; color: var(--color-green-terminal); }
  .centro-desc { font-size: 0.8rem; color: var(--color-dim); margin: 0; }
  .log-footer { margin-top: 20px; padding-top: 20px; border-top: 1px solid var(--border-alpha); text-align: center; }
</style>