---
import Layout from '../layouts/Layout.astro';

const proyectos = [
  { nombre: "LOG", link: "/log", icono: "📋", desc: "Registro y bitácora del sistema" },
  { nombre: "LE TEMATIK", link: "/le-tematik", icono: "🎵", desc: "Proyecto musical y artístico" },
  { nombre: "PROJECT NADA BRAHMA", link: "/nada-brahma", icono: "🕉️", desc: "Exploración filosófica y técnica" },
  { nombre: "TEXVN", link: "/texvn", icono: "🔧", desc: "Herramientas y técnicas operativas" },
  { nombre: "QUANTUMLAB", link: "/quantumlab", icono: "️", desc: "Laboratorio de experimentación" },
  { nombre: "PENSAMIENTO AUTISTA", link: "/pensamiento-autista", icono: "🧠", desc: "Modelos cognitivos" },
  { nombre: "SAIAYIN DO", link: "/saiayin-do", icono: "⚔️", desc: "Disciplina y camino de acción" },
  { nombre: "ARS TEKNE", link: "/ars-tekne", icono: "", desc: "Fundación artístico-técnica" },
  { nombre: "QUIRÓN THEATRE", link: "/quiron-theatre", icono: "🎭", desc: "Escena y performance" }
];
---

<Layout title="THE DIFFERENCE // MENU">
  <main class="menu-container">
    
    <header class="menu-header">
      <a href="/" class="back-link">← VOLVER AL INICIO</a>
      <h1 class="menu-title">THE DIFFERENCE // SYSTEM MENU</h1>
    </header>

    <hr class="menu-divider" />

    <section class="menu-intro">
      <div class="status-indicator">[ SELECT_MODULE_TO_INITIALIZE ]</div>
      <p class="intro-text">
        Selecciona un módulo del sistema para acceder a su panel de control, bitácora y herramientas de desarrollo.
      </p>
    </section>

    <div class="projects-grid">
      {proyectos.map((proyecto) => (
        <a href={proyecto.link} class="project-card">
          <div class="card-icon">{proyecto.icono}</div>
          <div class="card-content">
            <h2 class="card-title">{proyecto.nombre}</h2>
            <p class="card-desc">{proyecto.desc}</p>
          </div>
          <div class="card-arrow">→</div>
        </a>
      ))}
    </div>

    <hr class="menu-divider" />

    <footer class="menu-footer">
      <div>SYSTEM_READY // 9_MODULES_LOADED</div>
      <div>ARS TEKNE FOUNDATION © 2026</div>
    </footer>

  </main>
</Layout>

<style>
  :root {
    --bg-dark: #000000;
    --text-white: #ffffff;
    --punk-pink: #ff3e96;
    --border-color: rgba(255, 255, 255, 0.2);
    --font-mono: 'Courier New', Courier, monospace;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  .menu-container {
    background-color: var(--bg-dark);
    color: var(--text-white);
    font-family: var(--font-mono);
    min-height: 100vh;
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .menu-header {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .back-link {
    color: var(--text-white);
    text-decoration: none;
    font-size: 14px;
    transition: color 0.2s;
    align-self: flex-start;
  }

  .back-link:hover {
    color: var(--punk-pink);
  }

  .menu-title {
    font-size: 28px;
    color: var(--punk-pink);
    font-weight: bold;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .menu-divider {
    border: none;
    border-top: 1px solid var(--border-color);
    margin: 0;
  }

  .menu-intro {
    padding: 0 10px;
  }

  .status-indicator {
    font-size: 14px;
    color: var(--punk-pink);
    margin-bottom: 10px;
    font-weight: bold;
    letter-spacing: 1px;
  }

  .intro-text {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-white);
    max-width: 700px;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 20px;
    padding: 10px 0;
  }

  .project-card {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 25px;
    border: 1px solid var(--border-color);
    background: rgba(255, 255, 255, 0.02);
    text-decoration: none;
    color: var(--text-white);
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .project-card:hover {
    border-color: var(--punk-pink);
    background: rgba(255, 62, 150, 0.05);
    transform: translateX(8px);
  }

  .card-icon {
    font-size: 32px;
    flex-shrink: 0;
  }

  .card-content {
    flex: 1;
    min-width: 0;
  }

  .card-title {
    font-size: 16px;
    color: var(--text-white);
    font-weight: bold;
    margin-bottom: 6px;
    letter-spacing: 1px;
  }

  .card-desc {
    font-size: 12px;
    color: var(--text-white);
    opacity: 0.7;
    line-height: 1.4;
  }

  .card-arrow {
    font-size: 24px;
    color: var(--text-white);
    opacity: 0.5;
    transition: all 0.2s;
  }

  .project-card:hover .card-arrow {
    color: var(--punk-pink);
    opacity: 1;
    transform: translateX(4px);
  }

  .menu-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    color: var(--text-white);
    opacity: 0.7;
    margin-top: auto;
    padding-top: 20px;
  }

  @media (max-width: 768px) {
    .menu-container {
      padding: 20px;
    }

    .menu-title {
      font-size: 20px;
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }

    .project-card {
      padding: 20px;
    }
  }
</style>