---
import Layout from '../layouts/Layout.astro';
import MenuReturn from '../components/MenuReturn.astro';

const API_URL = "PEGUE_AQUI_LA_URL_DE_LA_APLICACION_WEB";
let systemStatus = "DISCONNECTED";

if (API_URL && !API_URL.includes("PEGUE_AQUI") && API_URL.endsWith("/exec")) {
  try {
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), 5000);
    const response = await fetch(API_URL, { 
      method: 'GET', 
      headers: { 'Accept': 'application/json' }, 
      signal: controller.signal 
    });
    clearTimeout(timeoutId);
    const rawText = await response.text();
    if (rawText.trim().startsWith('{')) {
      const json = JSON.parse(rawText);
      if (json.success) systemStatus = "ONLINE";
    }
  } catch (error) {
    systemStatus = "OFFLINE";
  }
}
---

<Layout title="ARS_TEKNE // ORÁCULO IA">
  
  <MenuReturn href="/menu" label="THE DIFFERENCE" />

  <main class="chat-terminal">
    <header class="chat-header">
      <div class="brand">
        <h1>ORÁCULO_IA</h1>
        <p class="subtitle">NÚCLEO COGNITIVO GPT // ASISTENTE ONTOLÓGICO</p>
      </div>
      <div class={systemStatus === "ONLINE" ? "system-badge online" : "system-badge offline"}>
        <span class="pulse-dot"></span>
        <span class="status-text">SYS_STATUS: {systemStatus}</span>
      </div>
    </header>

    <hr class="terminal-divider" />

    <section class="chat-container">
      <div class="panel-header-text">[ TRANSMISIÓN DE DATOS COGNITIVOS ]</div>
      
      <div class="chat-window" id="chatWindow">
        <div class="chat-message system">
          <span class="msg-prefix">> SYSTEM:</span>
          <span class="msg-text">Bienvenido al Núcleo Cognitivo. Soy el Oráculo de ARS_TEKNE.</span>
        </div>
      </div>

      <div class="chat-input-area">
        <span class="prompt-char">&gt;</span>
        <textarea id="chatInput" placeholder="Escribe tu consulta al oráculo..." rows="2"></textarea>
        <button id="sendBtn">TRANSMITIR</button>
      </div>
    </section>

    <footer class="chat-footer">
      <p class="dim">ARS_TEKNE v1.0 // GPT INTEGRATION</p>
    </footer>
  </main>
</Layout>

<style>
  :root { --color-black: #000000; --color-white: #ffffff; --color-pink: #ff3e96; --color-green-terminal: #00ff00; --color-dim: #555555; --border-alpha: rgba(255, 255, 255, 0.15); --font-mono: 'Courier New', Courier, monospace; --font-sans: 'Impact', 'Arial Black', sans-serif; }
  body { background-color: var(--color-black) !important; color: var(--color-white); margin: 0; padding: 0; }
  .chat-terminal { font-family: var(--font-mono); background-color: var(--color-black); padding: 20px; max-width: 1000px; margin: 0 auto; display: flex; flex-direction: column; gap: 20px; box-sizing: border-box; min-height: 100vh; }
  .terminal-divider { border: 0; border-top: 1px solid var(--border-alpha); margin: 0; width: 100%; }
  .panel-header-text { font-size: 0.8rem; color: var(--color-white); letter-spacing: 2px; margin-bottom: 10px; font-weight: bold; }
  .chat-header { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; }
  .brand h1 { font-family: var(--font-sans); font-size: 3rem; margin: 0; letter-spacing: 2px; line-height: 1; color: var(--color-green-terminal); }
  .subtitle { margin: 5px 0 0 0; font-size: 0.85rem; color: var(--color-white); letter-spacing: 1px; }
  .system-badge { display: flex; align-items: center; gap: 10px; border: 1px solid var(--border-alpha); padding: 8px 16px; font-size: 0.85rem; font-weight: bold; }
  .system-badge.online { border-color: var(--color-green-terminal); color: var(--color-green-terminal); }
  .system-badge.offline { border-color: #ff3333; color: #ff3333; }
  .pulse-dot { width: 8px; height: 8px; border-radius: 50%; background-color: currentColor; box-shadow: 0 0 8px currentColor; }
  .chat-container { border: 1px solid var(--border-alpha); padding: 15px; flex-grow: 1; display: flex; flex-direction: column; }
  .chat-window { flex-grow: 1; height: 500px; overflow-y: auto; display: flex; flex-direction: column; gap: 15px; padding: 10px; background: #050505; border: 1px solid var(--border-alpha); margin-bottom: 15px; }
  .chat-message { display: flex; flex-direction: column; gap: 5px; padding: 10px; border-left: 2px solid var(--border-alpha); background: rgba(255, 255, 255, 0.02); }
  .chat-message.user { border-left-color: var(--color-pink); align-items: flex-end; }
  .chat-message.system { border-left-color: var(--color-green-terminal); }
  .chat-message.ai { border-left-color: #00ffff; }
  .msg-prefix { font-size: 0.75rem; font-weight: bold; }
  .chat-message.user .msg-prefix { color: var(--color-pink); }
  .chat-message.system .msg-prefix { color: var(--color-green-terminal); }
  .chat-message.ai .msg-prefix { color: #00ffff; }
  .msg-text { font-size: 0.95rem; line-height: 1.5; white-space: pre-wrap; }
  .chat-input-area { display: flex; align-items: flex-end; gap: 10px; padding: 10px; background: #0a0a0a; border: 1px solid var(--border-alpha); }
  .prompt-char { color: var(--color-pink); font-weight: bold; font-size: 1.2rem; margin-bottom: 12px; }
  #chatInput { flex-grow: 1; background: transparent; border: none; color: var(--color-white); font-family: var(--font-mono); font-size: 0.95rem; outline: none; resize: none; padding: 10px 0; }
  #sendBtn { background: transparent; border: 1px solid var(--color-green-terminal); color: var(--color-green-terminal); font-family: var(--font-mono); font-size: 0.85rem; padding: 10px 20px; cursor: pointer; }
  #sendBtn:hover:not(:disabled) { background: var(--color-green-terminal); color: var(--color-black); }
  #sendBtn:disabled { opacity: 0.3; cursor: not-allowed; }
  .chat-footer { margin-top: 20px; padding-top: 10px; border-top: 1px solid var(--border-alpha); text-align: right; font-size: 0.75rem; }
</style>

<script define:vars={{ API_URL }}>
  const chatWindow = document.getElementById('chatWindow');
  const chatInput = document.getElementById('chatInput');
  const sendBtn = document.getElementById('sendBtn');

  function agregarMensaje(texto, tipo) {
    const div = document.createElement('div');
    div.className = `chat-message ${tipo}`;
    let prefijo = '> USER:';
    if (tipo === 'system') prefijo = '> SYSTEM:';
    if (tipo === 'ai') prefijo = '> ORÁCULO:';
    div.innerHTML = `<span class="msg-prefix">${prefijo}</span><span class="msg-text">${texto}</span>`;
    chatWindow.appendChild(div);
    chatWindow.scrollTop = chatWindow.scrollHeight;
  }

  async function enviarMensaje() {
    const texto = chatInput.value.trim();
    if (!texto) return;
    chatInput.disabled = true;
    sendBtn.disabled = true;
    sendBtn.textContent = 'PROCESANDO...';
    agregarMensaje(texto, 'user');
    chatInput.value = '';
    try {
      const payload = { accion: 'CHAT_IA', mensaje: texto };
      await fetch(API_URL, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      agregarMensaje("Transmisión recibida. El Oráculo está procesando...", 'system');
    } catch (err) {
      agregarMensaje(`Error: ${err.message}`, 'system');
    } finally {
      chatInput.disabled = false;
      sendBtn.disabled = false;
      sendBtn.textContent = 'TRANSMITIR';
      chatInput.focus();
    }
  }

  sendBtn.addEventListener('click', enviarMensaje);
  chatInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      enviarMensaje();
    }
  });
</script>