---
import Layout from '../layouts/Layout.astro';
import MenuReturn from '../components/MenuReturn.astro';

const API_URL = "PEGUE_AQUI_LA_URL_DE_LA_APLICACION_WEB";
let systemStatus = "DISCONNECTED";

if (API_URL && !API_URL.includes("PEGUE_AQUI") && API_URL.endsWith("/exec")) {
  try {
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), 5000);
    const response = await fetch(API_URL, { 
      method: 'GET', 
      headers: { 'Accept': 'application/json' }, 
      signal: controller.signal 
    });
    clearTimeout(timeoutId);
    const rawText = await response.text();
    if (rawText.trim().startsWith('{')) {
      const json = JSON.parse(rawText);
      if (json.success) systemStatus = "ONLINE";
    }
  } catch (error) {
    systemStatus = "OFFLINE";
  }
}
---

<Layout title="ARS_TEKNE // NÚCLEO ONTOLÓGICO">
  
  <MenuReturn href="/menu" label="THE DIFFERENCE" />

  <main class="tekne-terminal">
    <header class="tekne-header">
      <div class="brand">
        <h1>ARS_TEKNE</h1>
        <p class="subtitle">ARTE Y TÉCNICA // LA DIFERENCIA CUÁNTICA</p>
      </div>
      <div class={systemStatus === "ONLINE" ? "system-badge online" : "system-badge offline"}>
        <span class="pulse-dot"></span>
        <span class="status-text">SYS_STATUS: {systemStatus}</span>
      </div>
    </header>

    <hr class="terminal-divider" />

    <section class="manifesto-section">
      <div class="panel-header-text">[ MANIFIESTO DEL SISTEMA ]</div>
      <div class="manifesto-text">
        <p><span class="highlight">ARS_TEKNE</span> es la materialización de la memoria del flujo vital.</p>
      </div>
    </section>

    <section class="dialectic-section">
      <div class="panel-header-text">[ ESTRUCTURA DIALÉCTICA ]</div>
      <div class="dialectic-grid">
        <div class="dialectic-card tesis">
          <div class="card-header"><span class="card-icon">01</span><h3>TESIS</h3></div>
          <div class="card-body">
            <p class="concept">Fenómeno Puro</p>
            <p class="description">La idea inicial, el error fundacional.</p>
          </div>
        </div>
        <div class="dialectic-card antitesis">
          <div class="card-header"><span class="card-icon">02</span><h3>ANTÍTESIS</h3></div>
          <div class="card-body">
            <p class="concept">Reacción / Fricción</p>
            <p class="description">El código emergente, los fallos de red.</p>
          </div>
        </div>
        <div class="dialectic-card sintesis">
          <div class="card-header"><span class="card-icon">03</span><h3>SÍNTESIS</h3></div>
          <div class="card-body">
            <p class="concept">Comprensión / Destilación</p>
            <p class="description">El sistema operativo resultante.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="node-link-section">
      <div class="panel-header-text">[ NODOS CONECTADOS ]</div>
      <div class="node-links">
        <a href="/dashboard" class="node-btn">> ACCEDER AL DASHBOARD BIOS</a>
        <a href="/log" class="node-btn">> EXPLORAR LA BITÁCORA GLOBAL</a>
        <a href="/chat" class="node-btn">> CONSULTAR AL ORÁCULO IA</a>
      </div>
    </section>

    <footer class="tekne-footer">
      <p class="dim">ARS_TEKNE v1.0 // THE DIFFERENCE</p>
    </footer>
  </main>
</Layout>

<style>
  :root { --color-black: #000000; --color-white: #ffffff; --color-pink: #ff3e96; --color-green-terminal: #00ff00; --color-dim: #555555; --border-alpha: rgba(255, 255, 255, 0.15); --font-mono: 'Courier New', Courier, monospace; --font-sans: 'Impact', 'Arial Black', sans-serif; }
  body { background-color: var(--color-black) !important; color: var(--color-white); margin: 0; padding: 0; }
  .tekne-terminal { font-family: var(--font-mono); background-color: var(--color-black); padding: 20px; max-width: 1200px; margin: 0 auto; display: flex; flex-direction: column; gap: 30px; box-sizing: border-box; min-height: 100vh; }
  .terminal-divider { border: 0; border-top: 1px solid var(--border-alpha); margin: 0; width: 100%; }
  .panel-header-text { font-size: 0.8rem; color: var(--color-white); letter-spacing: 2px; margin-bottom: 15px; font-weight: bold; border-left: 3px solid var(--color-pink); padding-left: 10px; }
  .tekne-header { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; }
  .brand h1 { font-family: var(--font-sans); font-size: 4rem; margin: 0; letter-spacing: 4px; line-height: 1; color: var(--color-white); text-shadow: 2px 2px 0px var(--color-pink); }
  .subtitle { margin: 5px 0 0 0; font-size: 0.9rem; color: var(--color-green-terminal); letter-spacing: 2px; }
  .system-badge { display: flex; align-items: center; gap: 10px; border: 1px solid var(--border-alpha); padding: 8px 16px; font-size: 0.85rem; font-weight: bold; }
  .system-badge.online { border-color: var(--color-green-terminal); color: var(--color-green-terminal); }
  .system-badge.offline { border-color: #ff3333; color: #ff3333; }
  .pulse-dot { width: 8px; height: 8px; border-radius: 50%; background-color: currentColor; box-shadow: 0 0 8px currentColor; }
  .manifesto-section { border: 1px solid var(--border-alpha); padding: 25px; background: rgba(255, 255, 255, 0.02); }
  .manifesto-text { font-size: 1.1rem; line-height: 1.8; color: #cccccc; }
  .manifesto-text .highlight { color: var(--color-pink); font-weight: bold; }
  .dialectic-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; }
  .dialectic-card { border: 1px solid var(--border-alpha); background: #050505; transition: all 0.3s ease; }
  .dialectic-card:hover { border-color: var(--color-white); transform: translateY(-5px); }
  .card-header { padding: 15px; border-bottom: 1px solid var(--border-alpha); display: flex; align-items: center; gap: 15px; }
  .card-icon { font-family: var(--font-sans); font-size: 1.5rem; color: var(--color-dim); }
  .card-header h3 { margin: 0; font-family: var(--font-sans); font-size: 1.5rem; letter-spacing: 2px; }
  .card-body { padding: 20px; }
  .concept { color: var(--color-green-terminal); font-weight: bold; margin: 0 0 10px 0; font-size: 0.9rem; letter-spacing: 1px; }
  .description { color: #aaaaaa; line-height: 1.6; margin-bottom: 20px; font-size: 0.95rem; }
  .node-links { display: flex; flex-direction: column; gap: 10px; }
  .node-btn { display: block; padding: 15px 20px; border: 1px solid var(--border-alpha); color: var(--color-white); text-decoration: none; font-family: var(--font-mono); font-size: 1rem; letter-spacing: 1px; transition: all 0.2s ease; }
  .node-btn:hover { background-color: var(--color-pink); color: var(--color-black); border-color: var(--color-pink); padding-left: 30px; }
  .tekne-footer { margin-top: 30px; padding-top: 20px; border-top: 1px solid var(--border-alpha); text-align: center; }
  .tekne-footer p { margin: 5px 0; }
</style>