<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MENÚ - THE DIFFERENCE</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      background: #000000;
      min-height: 100vh;
      font-family: 'Helvetica', 'Arial', sans-serif;
      color: #ffffff;
      overflow: hidden;
    }
    
    .main-container {
      position: relative;
      width: 100vw;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
    }
    
    /* BOTÓN PRINCIPAL - ARRIBA (CLICKABLE) */
    .main-btn {
      position: absolute;
      top: 12%;
      left: 50%;
      transform: translateX(-50%);
      font-size: 56px;
      font-weight: 900;
      font-family: 'Helvetica', 'Arial', sans-serif;
      color: #ffffff;
      text-transform: uppercase;
      letter-spacing: 8px;
      border: 2px solid #ffffff;
      border-bottom: 2px solid #ff0000;
      padding: 20px 50px;
      background: #000000;
      text-decoration: none;
      cursor: pointer;
      z-index: 10;
      white-space: nowrap;
      transition: all 0.3s ease;
    }
    
    .main-btn:hover {
      background: #222222;
      transform: translateX(-50%) scale(1.05);
      box-shadow: 0 0 40px rgba(255, 255, 255, 0.5);
      border-bottom-color: #ff3333;
    }
    
    /* GRID DE BOTONES - CENTRO, DEBAJO DEL TÍTULO */
    .menu-grid {
      position: absolute;
      top: 38%;
      left: 50%;
      transform: translateX(-50%);
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 15px 20px;
      max-width: 1000px;
      width: 90%;
      z-index: 10;
    }
    
    .menu-btn {
      padding: 18px 20px;
      background: #000000;
      border: 2px solid #ffffff;
      color: #ffde00;
      text-decoration: none;
      font-family: 'Helvetica', 'Arial', sans-serif;
      font-weight: 900;
      font-size: 16px;
      text-transform: uppercase;
      letter-spacing: 2px;
      text-align: center;
      cursor: pointer;
      transition: all 0.3s ease;
      border-radius: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 70px;
    }
    
    .menu-btn:hover {
      background: #222222;
      transform: scale(1.05);
      box-shadow: 0 0 20px rgba(255, 222, 0, 0.4);
    }
    
    /* BOTÓN INFERIOR - ABAJO */
    .bottom-btn {
      position: absolute;
      bottom: 8%;
      left: 50%;
      transform: translateX(-50%);
      padding: 12px 30px;
      background: #000000;
      border: 2px solid #ffffff;
      color: #ff00aa;
      text-decoration: none;
      font-family: 'Helvetica', 'Arial', sans-serif;
      font-weight: 900;
      font-size: 16px;
      text-transform: uppercase;
      letter-spacing: 2px;
      cursor: pointer;
      transition: all 0.3s ease;
      z-index: 10;
    }
    
    .bottom-btn:hover {
      background: #222222;
      transform: scale(1.05);
      box-shadow: 0 0 20px rgba(255, 0, 170, 0.4);
    }
    
    /* RESPONSIVE */
    @media (max-width: 900px) {
      .main-btn {
        font-size: 36px;
        padding: 15px 30px;
        top: 10%;
      }
      
      .menu-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 12px 15px;
        top: 35%;
      }
      
      .menu-btn {
        padding: 14px 16px;
        font-size: 14px;
        min-height: 60px;
      }
    }
    
    @media (max-width: 500px) {
      .main-btn {
        font-size: 24px;
        padding: 12px 20px;
        letter-spacing: 4px;
      }
      
      .menu-grid {
        grid-template-columns: 1fr;
        gap: 10px;
        top: 30%;
        width: 85%;
      }
    }
  </style>
</head>
<body>
  <div class="main-container">
    <!-- BOTÓN PRINCIPAL - ARRIBA (CLICKABLE) -->
    <a href="/the-difference" class="main-btn">
      THE DIFFERENCE
    </a>
    
    <!-- GRID DE BOTONES - CENTRO -->
    <div class="menu-grid">
      <a href="/sheet-nodos" class="menu-btn">LOG</a>
      <a href="#" class="menu-btn">LE TEMATIK</a>
      <a href="#" class="menu-btn">PROJECT NADA BRAHMA</a>
      <a href="#" class="menu-btn">TEXVN</a>
      <a href="#" class="menu-btn">QUANTUMLAB</a>
      <a href="#" class="menu-btn">PENSAMIENTO AUTISTA</a>
      <a href="#" class="menu-btn">SAIAYIN DO</a>
      <a href="#" class="menu-btn">ARS TEKNE</a>
      <a href="#" class="menu-btn">QUIRÓN THEATRE</a>
    </div>
    
    <!-- BOTÓN INFERIOR - ABAJO -->
    <a href="#" class="bottom-btn">LE TEMATIK DESIGN</a>
  </div>
</body>
</html>