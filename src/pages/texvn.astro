---
import fs from 'fs/promises';
import path from 'path';
import { fileURLToPath } from 'url';

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const rootDir = path.resolve(__dirname, '../..');

// Principios filosóficos del oficio
const principles = [
  "Bordes éticos por sobre los legales",
  "Categóricos del sentido, no de la conducta",
  "Autopoiesis sobre adaptación forzada",
  "Potencia de la Diferencia en integración",
  "Bienestar, energía, salud como métrica",
  "Lo técnico pensado para NO generar stress",
  "Valor colectivo sobre valor de mercado",
  "Pensamiento crítico en posición de valor"
];

// Las 13 etapas del desarrollo técnico sonoro
const phases = {
  pre: {
    name: "PRE — TESIS",
    greek: "Prothesis (Πρόθεσις)",
    symbol: "🌱",
    description: "Antes del evento. Exploración, diseño, valorización y pre-programación. El pensamiento precede a la acción.",
    color: "#7c3aed",
    stages: [
      {
        num: 1,
        name: "Exploración / Vista Técnica / Información",
        description: "Reconocimiento del terreno. Lectura del espacio, los recursos, las limitaciones y las posibilidades. Escucha activa del entorno sonoro y técnico.",
        methods: ["Relevamiento técnico", "Análisis de frecuencias", "Mapeo de recursos", "Escucha del espacio"],
        contents: ["Información técnica del lugar", "Recursos disponibles", "Limitaciones físicas", "Posibilidades sonoras"],
        languages: ["Diagnóstico técnico", "Documentación de campo", "Mapas de frecuencia", "Inventarios"]
      },
      {
        num: 2,
        name: "Diseño / Propuesta",
        description: "Arquitectura del sonido. Diseño de la experiencia sonora desde la intención consciente. La propuesta como acto creativo fundacional.",
        methods: ["Diseño sonoro", "Arquitectura de experiencia", "Propuesta creativa", "Planificación técnica"],
        contents: ["Concepto sonoro", "Diseño de instalación", "Propuesta artística", "Plan técnico"],
        languages: ["Diagramas de flujo", "Renderizados sonoros", "Documentos de diseño", "Propuestas creativas"]
      },
      {
        num: 3,
        name: "Valorización / Contrato / Presentación",
        description: "Acuerdo consciente. Valorización del trabajo desde el sentido, no desde el mercado. Contrato como pacto ético entre partes.",
        methods: ["Valorización consciente", "Negociación ética", "Presentación del proyecto", "Acuerdo mutuo"],
        contents: ["Presupuesto consciente", "Contrato ético", "Presentación del concepto", "Acuerdos de trabajo"],
        languages: ["Documentos legales éticos", "Propuestas de valor", "Presentaciones visuales", "Acuerdos escritos"]
      },
      {
        num: 4,
        name: "Pre-programación del Sistema",
        description: "Configuración previa. Preparación del sistema técnico antes del montaje. Código que espera su momento de manifestación.",
        methods: ["Programación preventiva", "Configuración de sistemas", "Pruebas de laboratorio", "Preparación de equipos"],
        contents: ["Código base", "Configuraciones", "Equipos preparados", "Sistemas testeados"],
        languages: ["JavaScript/Node.js", "JSON de configuración", "Scripts de preparación", "Documentación técnica"]
      }
    ]
  },
  presente: {
    name: "PRESENTE — ANTÍTESIS",
    greek: "Praxis (Πρᾶξις)",
    symbol: "⚡",
    description: "Ejecución. El pensamiento se hace acción. Montaje, instalación, ejecución y prueba. El presente como campo de batalla creativo.",
    color: "#ff3e96",
    stages: [
      {
        num: 5,
        name: "Montaje",
        description: "Instalación física. El espacio se transforma. Cables, equipos, estructuras. El cuerpo del desarrollador sonoro en acción.",
        methods: ["Montaje físico", "Instalación de equipos", "Configuración espacial", "Ajuste acústico"],
        contents: ["Equipos instalados", "Cableado", "Estructuras", "Espacio transformado"],
        languages: ["Lenguaje corporal", "Herramientas técnicas", "Señales de audio", "Comunicación en equipo"]
      },
      {
        num: 6,
        name: "Instalación / Programación",
        description: "Activación del sistema. El código cobra vida en el espacio. Programación in situ, ajustes en tiempo real.",
        methods: ["Programación in situ", "Ajuste fino", "Calibración", "Integración de sistemas"],
        contents: ["Sistema activo", "Código ejecutándose", "Audio fluyendo", "Sistemas integrados"],
        languages: ["Código en vivo", "Consolas de audio", "Interfaces técnicas", "Monitoreo en tiempo real"]
      },
      {
        num: 7,
        name: "Ejecución / Seguimiento / Desarrollo",
        description: "El sistema opera. Acompañamiento consciente del proceso. Desarrollo continuo, ajustes según respuesta del espacio y el público.",
        methods: ["Operación consciente", "Monitoreo activo", "Ajustes en vivo", "Desarrollo continuo"],
        contents: ["Sistema operando", "Respuesta del espacio", "Feedback del público", "Ajustes realizados"],
        languages: ["Observación activa", "Registro de eventos", "Comunicación con el equipo", "Ajustes técnicos"]
      },
      {
        num: 8,
        name: "Prueba / Test",
        description: "Validación ontológica. ¿El sistema sostiene la Diferencia? Pruebas de estrés, de flujo, de bienestar. El sistema debe funcionar SIN generar stress.",
        methods: ["Testing consciente", "Pruebas de estrés", "Validación de flujo", "Test de bienestar"],
        contents: ["Resultados de pruebas", "Métricas de flujo", "Indicadores de stress", "Validaciones técnicas"],
        languages: ["Logs de prueba", "Reportes de errores", "Métricas de rendimiento", "Feedback técnico"]
      }
    ]
  },
  post: {
    name: "POST — SÍNTESIS",
    greek: "Synthesis (Σύνθεσις)",
    symbol: "🌾",
    description: "Después del evento. Desmontaje, backup, post-programación y bitácora. La cosecha consciente del proceso vivido.",
    color: "#10b981",
    stages: [
      {
        num: 9,
        name: "Desmontaje / Logística",
        description: "Cierre físico consciente. Desmontaje con respeto al espacio y los equipos. Logística como acto de cuidado, no de prisa.",
        methods: ["Desmontaje consciente", "Empaque cuidadoso", "Logística organizada", "Cierre del espacio"],
        contents: ["Equipos desmontados", "Espacio restaurado", "Materiales organizados", "Logística completada"],
        languages: ["Checklists de cierre", "Inventarios de retorno", "Documentación logística", "Fotos del proceso"]
      },
      {
        num: 10,
        name: "Backup",
        description: "Preservación de la memoria. Respaldo técnico y emocional del proceso. El sistema se guarda a sí mismo para futuras iteraciones.",
        methods: ["Backup técnico", "Respaldo emocional", "Preservación de datos", "Archivado consciente"],
        contents: ["Datos respaldados", "Código versionado", "Registros emocionales", "Documentación completa"],
        languages: ["Sistemas de backup", "Git/versionado", "JSON de registro", "Emails de notificación"]
      },
      {
        num: 11,
        name: "Post-programación / Desarrollo",
        description: "Refinamiento posterior. Mejoras basadas en la experiencia vivida. El código evoluciona después del evento.",
        methods: ["Refactorización consciente", "Mejoras post-evento", "Optimización", "Evolución del sistema"],
        contents: ["Código mejorado", "Sistema optimizado", "Lecciones aprendidas", "Nuevas funcionalidades"],
        languages: ["Código refactorizado", "Documentación actualizada", "Notas de evolución", "Plan de mejoras"]
      },
      {
        num: 12,
        name: "Bitácora / Presentación / Valor Colectivo",
        description: "Registro consciente del proceso. Presentación de la bitácora como legado. Valor colectivo sobre valor individual. El conocimiento se comparte.",
        methods: ["Escritura de bitácora", "Presentación del proceso", "Compartir conocimiento", "Construcción colectiva"],
        contents: ["Bitácora completa", "Lecciones documentadas", "Conocimiento compartido", "Legado para otros"],
        languages: ["TEXVN (bitácora)", "Documentos de legado", "Presentaciones públicas", "Comunidad de práctica"]
      }
    ]
  },
  atemporal: {
    name: "DESPLEGUE — FUERA DEL TIEMPO",
    greek: "Anagogé (Αναγωγή)",
    symbol: "🕊️",
    description: "La etapa 13. Fuera del tiempo cronológico. TEXVN como finalización consciente. Sentido, movimiento, autonomía, pensamiento crítico. La bitácora técnica en su autonomía.",
    color: "#f59e0b",
    stage: {
      num: 13,
      name: "Despegue / TEXVN / Finalización / Sentido / Movimiento",
      description: "El sistema respira solo. La bitácora cobra autonomía. El desarrollador se libera del proceso. Pensamiento crítico en posición de valor. La Diferencia se sostiene por sí misma.",
      methods: [
        "Autonomía del sistema",
        "Pensamiento crítico activo",
        "Movimiento consciente",
        "Sentido auto-sostenido"
      ],
      contents: [
        "Sistema autónomo operando",
        "Bitácora viva",
        "Pensamiento crítico documentado",
        "Valor en movimiento"
      ],
      languages: [
        "Código que se auto-mantiene",
        "Bitácora que se auto-registra",
        "Pensamiento que se auto-critica",
        "Sistema que se auto-repara"
      ]
    }
  }
};
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>TEXVN | Las 13 Etapas del Desarrollo Técnico Sonoro</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { 
      background: linear-gradient(135deg, #0a0a0a 0%, #1a1a2e 100%); 
      color: #e0e0e0; 
      font-family: 'Courier New', Courier, monospace; 
      min-height: 100vh; 
      padding: 40px 20px;
    }
    
    .container { max-width: 1400px; margin: 0 auto; }
    
    .header { 
      text-align: center; 
      margin-bottom: 60px; 
      border-bottom: 3px solid #ff3e96; 
      padding-bottom: 30px;
    }
    
    .header h1 { 
      font-size: 3rem; 
      color: #ff3e96; 
      margin-bottom: 10px;
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }
    
    .header .subtitle {
      font-size: 1.3rem;
      color: #7c3aed;
      margin-bottom: 15px;
      font-style: italic;
    }
    
    .btn-back { 
      display: inline-block;
      border: 3px solid white; 
      padding: 12px 25px; 
      font-size: 16px; 
      font-weight: bold; 
      text-transform: uppercase; 
      cursor: pointer; 
      background: transparent; 
      color: white; 
      transition: 0.3s; 
      text-decoration: none; 
      margin-bottom: 40px;
    }
    
    .btn-back:hover { border-color: #ff3e96; color: #ff3e96; }
    
    /* Principios filosóficos */
    .principles-section {
      background: rgba(124, 58, 237, 0.1);
      border: 2px solid #7c3aed;
      padding: 30px;
      border-radius: 15px;
      margin-bottom: 50px;
    }
    
    .principles-section h2 {
      color: #7c3aed;
      font-size: 1.8rem;
      margin-bottom: 20px;
      text-align: center;
      text-transform: uppercase;
    }
    
    .principles-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 15px;
    }
    
    .principle-item {
      background: rgba(0, 0, 0, 0.3);
      padding: 15px 20px;
      border-radius: 8px;
      border-left: 3px solid #ff3e96;
      color: #9ca3af;
      font-size: 0.95rem;
      line-height: 1.5;
    }
    
    /* Estructura dialéctica */
    .dialectic-intro {
      text-align: center;
      margin-bottom: 60px;
      padding: 30px;
      background: rgba(255, 62, 150, 0.05);
      border-radius: 15px;
    }
    
    .dialectic-intro h2 {
      color: #ff3e96;
      font-size: 2rem;
      margin-bottom: 20px;
    }
    
    .dialectic-formula {
      font-size: 1.5rem;
      color: #7c3aed;
      margin: 20px 0;
      font-weight: bold;
    }
    
    .dialectic-intro p {
      color: #9ca3af;
      font-size: 1.1rem;
      line-height: 1.6;
      max-width: 900px;
      margin: 0 auto;
    }
    
    /* Fases */
    .phase-section {
      margin-bottom: 80px;
    }
    
    .phase-header {
      display: flex;
      align-items: center;
      gap: 20px;
      margin-bottom: 30px;
      padding: 25px;
      border-radius: 15px;
      flex-wrap: wrap;
    }
    
    .phase-symbol {
      font-size: 3rem;
    }
    
    .phase-header h2 {
      font-size: 2.2rem;
      text-transform: uppercase;
      flex: 1;
    }
    
    .phase-greek {
      background: rgba(255, 255, 255, 0.1);
      padding: 8px 15px;
      border-radius: 20px;
      font-size: 0.9rem;
      font-style: italic;
    }
    
    .phase-description {
      color: #9ca3af;
      font-size: 1.1rem;
      line-height: 1.6;
      padding: 0 25px 25px 25px;
      border-left: 4px solid;
      margin-left: 25px;
    }
    
    /* Etapas */
    .stages-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 30px;
      padding: 0 25px;
    }
    
    .stage-card {
      background: rgba(255, 255, 255, 0.03);
      border: 2px solid #333;
      border-radius: 15px;
      padding: 30px;
      position: relative;
      transition: 0.3s;
    }
    
    .stage-card:hover {
      transform: translateX(10px);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    }
    
    .stage-number {
      position: absolute;
      top: 20px;
      right: 30px;
      font-size: 4rem;
      font-weight: bold;
      opacity: 0.2;
    }
    
    .stage-header {
      display: flex;
      align-items: center;
      gap: 15px;
      margin-bottom: 20px;
    }
    
    .stage-card h3 {
      font-size: 1.5rem;
      text-transform: uppercase;
      flex: 1;
    }
    
    .stage-description {
      color: #9ca3af;
      font-size: 1.05rem;
      line-height: 1.6;
      margin-bottom: 25px;
      padding-left: 15px;
      border-left: 3px solid #333;
    }
    
    .aspects-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 15px;
    }
    
    .aspect-box {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid #333;
      border-radius: 10px;
      padding: 20px;
    }
    
    .aspect-box h4 {
      margin-bottom: 12px;
      font-size: 1rem;
      text-transform: uppercase;
    }
    
    .aspect-box ul {
      list-style: none;
      padding-left: 0;
    }
    
    .aspect-box li {
      color: #6b7280;
      padding: 6px 0;
      padding-left: 20px;
      position: relative;
      font-size: 0.9rem;
      line-height: 1.4;
    }
    
    .aspect-box li::before {
      content: '→';
      position: absolute;
      left: 0;
    }
    
    /* Etapa 13 - Despegue */
    .despegue-section {
      background: linear-gradient(135deg, rgba(245, 158, 11, 0.1) 0%, rgba(255, 62, 150, 0.1) 100%);
      border: 3px solid #f59e0b;
      border-radius: 20px;
      padding: 50px;
      margin-top: 60px;
      position: relative;
      overflow: hidden;
    }
    
    .despegue-section::before {
      content: '🕊️';
      position: absolute;
      top: 20px;
      right: 30px;
      font-size: 5rem;
      opacity: 0.1;
    }
    
    .despegue-header {
      text-align: center;
      margin-bottom: 30px;
    }
    
    .despegue-header h2 {
      color: #f59e0b;
      font-size: 2.5rem;
      margin-bottom: 10px;
      text-transform: uppercase;
    }
    
    .despegue-header .greek {
      color: #ff3e96;
      font-size: 1.3rem;
      font-style: italic;
    }
    
    .despegue-description {
      color: #9ca3af;
      font-size: 1.2rem;
      text-align: center;
      max-width: 900px;
      margin: 0 auto 40px auto;
      line-height: 1.8;
    }
    
    .despegue-card {
      background: rgba(0, 0, 0, 0.3);
      border: 2px solid #f59e0b;
      border-radius: 15px;
      padding: 30px;
    }
    
    .despegue-card h3 {
      color: #f59e0b;
      font-size: 1.8rem;
      margin-bottom: 20px;
      text-align: center;
    }
    
    .final-message {
      text-align: center;
      margin-top: 40px;
      padding: 30px;
      background: rgba(245, 158, 11, 0.1);
      border-radius: 15px;
    }
    
    .final-message p {
      color: #f59e0b;
      font-size: 1.3rem;
      line-height: 1.6;
      font-weight: bold;
    }
    
    @media (max-width: 768px) {
      .header h1 { font-size: 2rem; }
      .phase-header { flex-direction: column; align-items: flex-start; }
      .aspects-grid { grid-template-columns: 1fr; }
      .despegue-section { padding: 30px 20px; }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <a href="/menu" class="btn-back">← THE DIFFERENCE</a>
      <h1>TEXVN</h1>
      <p class="subtitle">Las 13 Etapas del Desarrollo Técnico Sonoro</p>
      <p style="color: #6b7280; font-size: 1.1rem;">
        4 (Pre) + 4 (Presente) + 4 (Post) + 1 (Despegue) = 13 Etapas Conscientes
      </p>
    </div>
    
    {/* PRINCIPIOS FILOSÓFICOS */}
    <div class="principles-section">
      <h2>🧭 Principios del Oficio Sonoro</h2>
      <div class="principles-grid">
        {principles.map(p => (
          <div class="principle-item">{p}</div>
        ))}
      </div>
    </div>
    
    {/* INTRODUCCIÓN DIALÉCTICA */}
    <div class="dialectic-intro">
      <h2>Estructura Dialéctica del Oficio</h2>
      <div class="dialectic-formula">
        Tesis (Pre) → Antítesis (Presente) → Síntesis (Post) + Despegue (Atemporal)
      </div>
      <p>
        La bitácora registra el movimiento del oficio desde su comprensión de valor en el tiempo. 
        Desarrollo en posición de función, rendimiento, flujo y soporte. 
        El log de programación hace del tiempo valor posible: arte en la cuestión de bienestar, energía y salud.
      </p>
    </div>
    
    {/* FASE PRE */}
    <div class="phase-section">
      <div class="phase-header" style="background: rgba(124, 58, 237, 0.1); border-left: 5px solid #7c3aed;">
        <div class="phase-symbol">{phases.pre.symbol}</div>
        <h2 style="color: #7c3aed;">{phases.pre.name}</h2>
        <span class="phase-greek">{phases.pre.greek}</span>
      </div>
      <p class="phase-description" style="border-color: #7c3aed;">{phases.pre.description}</p>
      
      <div class="stages-grid">
        {phases.pre.stages.map(stage => (
          <div class="stage-card">
            <div class="stage-number" style="color: #7c3aed;">{String(stage.num).padStart(2, '0')}</div>
            <div class="stage-header">
              <h3 style="color: #7c3aed;">{stage.name}</h3>
            </div>
            <p class="stage-description">{stage.description}</p>
            <div class="aspects-grid">
              <div class="aspect-box">
                <h4 style="color: #7c3aed;">🔧 Métodos</h4>
                <ul>{stage.methods.map(m => <li>{m}</li>)}</ul>
              </div>
              <div class="aspect-box">
                <h4 style="color: #7c3aed;">📦 Contenidos</h4>
                <ul>{stage.contents.map(c => <li>{c}</li>)}</ul>
              </div>
              <div class="aspect-box">
                <h4 style="color: #7c3aed;">💻 Lenguajes</h4>
                <ul>{stage.languages.map(l => <li>{l}</li>)}</ul>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
    
    {/* FASE PRESENTE */}
    <div class="phase-section">
      <div class="phase-header" style="background: rgba(255, 62, 150, 0.1); border-left: 5px solid #ff3e96;">
        <div class="phase-symbol">{phases.presente.symbol}</div>
        <h2 style="color: #ff3e96;">{phases.presente.name}</h2>
        <span class="phase-greek">{phases.presente.greek}</span>
      </div>
      <p class="phase-description" style="border-color: #ff3e96;">{phases.presente.description}</p>
      
      <div class="stages-grid">
        {phases.presente.stages.map(stage => (
          <div class="stage-card">
            <div class="stage-number" style="color: #ff3e96;">{String(stage.num).padStart(2, '0')}</div>
            <div class="stage-header">
              <h3 style="color: #ff3e96;">{stage.name}</h3>
            </div>
            <p class="stage-description">{stage.description}</p>
            <div class="aspects-grid">
              <div class="aspect-box">
                <h4 style="color: #ff3e96;">🔧 Métodos</h4>
                <ul>{stage.methods.map(m => <li>{m}</li>)}</ul>
              </div>
              <div class="aspect-box">
                <h4 style="color: #ff3e96;">📦 Contenidos</h4>
                <ul>{stage.contents.map(c => <li>{c}</li>)}</ul>
              </div>
              <div class="aspect-box">
                <h4 style="color: #ff3e96;">💻 Lenguajes</h4>
                <ul>{stage.languages.map(l => <li>{l}</li>)}</ul>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
    
    {/* FASE POST */}
    <div class="phase-section">
      <div class="phase-header" style="background: rgba(16, 185, 129, 0.1); border-left: 5px solid #10b981;">
        <div class="phase-symbol">{phases.post.symbol}</div>
        <h2 style="color: #10b981;">{phases.post.name}</h2>
        <span class="phase-greek">{phases.post.greek}</span>
      </div>
      <p class="phase-description" style="border-color: #10b981;">{phases.post.description}</p>
      
      <div class="stages-grid">
        {phases.post.stages.map(stage => (
          <div class="stage-card">
            <div class="stage-number" style="color: #10b981;">{String(stage.num).padStart(2, '0')}</div>
            <div class="stage-header">
              <h3 style="color: #10b981;">{stage.name}</h3>
            </div>
            <p class="stage-description">{stage.description}</p>
            <div class="aspects-grid">
              <div class="aspect-box">
                <h4 style="color: #10b981;">🔧 Métodos</h4>
                <ul>{stage.methods.map(m => <li>{m}</li>)}</ul>
              </div>
              <div class="aspect-box">
                <h4 style="color: #10b981;">📦 Contenidos</h4>
                <ul>{stage.contents.map(c => <li>{c}</li>)}</ul>
              </div>
              <div class="aspect-box">
                <h4 style="color: #10b981;">💻 Lenguajes</h4>
                <ul>{stage.languages.map(l => <li>{l}</li>)}</ul>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
    
    {/* ETAPA 13 - DESPEGUE */}
    <div class="despegue-section">
      <div class="despegue-header">
        <h2>{phases.atemporal.name}</h2>
        <div class="greek">{phases.atemporal.greek}</div>
      </div>
      
      <p class="despegue-description">{phases.atemporal.description}</p>
      
      <div class="despegue-card">
        <h3>Etapa 13: {phases.atemporal.stage.name}</h3>
        <p class="stage-description" style="text-align: center; border: none; padding: 0;">
          {phases.atemporal.stage.description}
        </p>
        
        <div class="aspects-grid" style="margin-top: 30px;">
          <div class="aspect-box">
            <h4 style="color: #f59e0b;">🔧 Métodos</h4>
            <ul>{phases.atemporal.stage.methods.map(m => <li>{m}</li>)}</ul>
          </div>
          <div class="aspect-box">
            <h4 style="color: #f59e0b;">📦 Contenidos</h4>
            <ul>{phases.atemporal.stage.contents.map(c => <li>{c}</li>)}</ul>
          </div>
          <div class="aspect-box">
            <h4 style="color: #f59e0b;"> Lenguajes</h4>
            <ul>{phases.atemporal.stage.languages.map(l => <li>{l}</li>)}</ul>
          </div>
        </div>
      </div>
      
      <div class="final-message">
        <p>
          ️ La bitácora técnica en su autonomía.<br/>
          Pensamiento crítico en posición de valor.<br/>
          La Diferencia se sostiene por sí misma.
        </p>
      </div>
    </div>
  </div>
</body>
</html>