---
export interface Props {
  href?: string;
  label?: string;
}

const { href = "/chat", label = "THE DIFFERENCE" } = Astro.props;
---

<nav class="global-nav-fixed">
  <div class="nav-buttons">
    <a href="/chat" class="nav-btn">
      <span class="nav-icon">◈</span>
      <span class="nav-label">THE DIFFERENCE</span>
    </a>
    <a href="/dashboard" class="nav-btn">
      <span class="nav-icon"></span>
      <span class="nav-label">DASHBOARD</span>
    </a>
    <a href="/planificacion" class="nav-btn">
      <span class="nav-icon">🎯</span>
      <span class="nav-label">PANEL CONTROL</span>
    </a>
  </div>
</nav>

<style>
  .global-nav-fixed {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 9999;
  }
  
  .nav-buttons {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  
  .nav-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    background: #ff3e96;
    border: 2px solid #ff3e96;
    color: #000000;
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.75rem;
    font-weight: bold;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.2s ease;
    box-shadow: 0 0 10px rgba(255, 62, 150, 0.3);
  }
  
  .nav-btn:hover {
    background: #000000;
    color: #ff3e96;
    border-color: #ff3e96;
    box-shadow: 0 0 20px rgba(255, 62, 150, 0.8);
    transform: translateY(-2px);
  }
  
  .nav-icon { font-size: 1rem; }
  .nav-label { white-space: nowrap; }
  
  @media (max-width: 768px) {
    .global-nav-fixed { top: 10px; right: 10px; }
    .nav-buttons { flex-direction: column; gap: 5px; }
    .nav-btn { padding: 8px 12px; font-size: 0.7rem; }
  }
</style>