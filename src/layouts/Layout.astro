---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="THE DIFFERENCE - Neurodivergence Creative Philosophy Platform" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  
  body {
    background-color: #000000;
    color: #ffffff;
    font-family: 'Courier New', Courier, monospace;
  }
</style>