---
export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} - Feeling Autistic</title>
  <link rel="stylesheet" href="/styles/global.css">
</head>
<body>
  <header class="main-header">
    <div class="logo-container">
      <div class="logo-circle">
        <img src="/logo.png" alt="Feeling Autistic Logo">
      </div>
      <div class="logo-text">
        <h1>FEELING</h1>
        <h1>AUSTISTIC</h1>
        <p class="subtitle">INTUITIVE ANALITYC NEURODIVERGENCE CREATIVE PLATFORM</p>
        <p class="subtitle">NEURODIVERGENCE CREATIVE PHILOSOFY PLATFORM SYSTEM BITACORA TEXVN</p>
      </div>
    </div>
    
    <div class="main-title">
      <h2>THE DIFFERENCE</h2>
    </div>
    
    <nav class="main-menu">
      <a href="/" class="menu-button">INICIO</a>
      <a href="/log" class="menu-button">LOG</a>
      <a href="/le-tematik" class="menu-button">LE TEMATIK</a>
      <a href="/nada-brahma" class="menu-button">PROJECT NADA BRAHMA</a>
      <a href="/texvn" class="menu-button">TEXVN</a>
      <a href="/quantumlab" class="menu-button">QUANTUMLAB</a>
      <a href="/pensamiento-autista" class="menu-button">PENSAMIENTO AUTISTA</a>
      <a href="/saiayin-do" class="menu-button">SAIAYIN DO</a>
      <a href="/ars-tekne" class="menu-button">ARS TEKNE</a>
      <a href="/quiron-theatre" class="menu-button">QUIRÓN THEATRE</a>
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <footer class="main-footer">
    <div class="footer-brand">LE TEMATIK DESIGN</div>
  </footer>
</body>
</html>

<style>
  .main-header {
    background: #000;
    padding: 2rem;
    text-align: center;
  }

  .logo-container {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .logo-circle {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    overflow: hidden;
  }

  .logo-circle img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .logo-text h1 {
    color: white;
    font-size: 3rem;
    margin: 0;
    font-weight: bold;
  }

  .subtitle {
    color: white;
    font-size: 0.9rem;
    margin: 0.5rem 0;
    letter-spacing: 2px;
  }

  .main-title {
    border: 3px solid white;
    padding: 1.5rem 3rem;
    display: inline-block;
    margin: 2rem 0;
  }

  .main-title h2 {
    color: white;
    font-size: 3.5rem;
    margin: 0;
    font-weight: bold;
  }

  .main-menu {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  .menu-button {
    background: #000;
    border: 2px solid #ffcc00;
    color: #ffcc00;
    padding: 1rem 2rem;
    text-decoration: none;
    font-size: 1.2rem;
    font-weight: bold;
    transition: all 0.3s;
  }

  .menu-button:hover {
    background: #ffcc00;
    color: #000;
    transform: translateY(-3px);
  }

  .main-footer {
    background: #000;
    padding: 2rem;
    text-align: center;
    margin-top: 4rem;
  }

  .footer-brand {
    border: 2px solid #ff00ff;
    color: #ff00ff;
    padding: 1rem 2rem;
    display: inline-block;
    font-weight: bold;
    font-size: 1.2rem;
  }
</style>